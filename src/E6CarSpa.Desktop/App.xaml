<Application x:Class="E6CarSpa.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:E6CarSpa.Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- The app is login-first: the first MainWindow shown is the LoginWindow, which closes
         after a successful sign-in. Without this, WPF defaults to OnLastWindowClose, which
         would tear the process down the moment the login dialog closes — before the shell
         ever renders. -->
    <Application.ShutdownMode>OnExplicitShutdown</Application.ShutdownMode>
</Application>
