<UserControl x:Class="E6CarSpa.Desktop.Views.ShowroomReportView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Margin="28">
 <Grid>
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="*" />
 </Grid.RowDefinitions>

 <TextBlock Grid.Row="0" Text="Showroom Reports" Style="{DynamicResource H1}" />

 <!-- Filters -->
 <Border Grid.Row="1" Style="{DynamicResource Card}">
 <StackPanel>
 <TextBlock Text="Filters" Style="{DynamicResource H2}" />
 <Grid>
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="Auto" />
 </Grid.ColumnDefinitions>
 <StackPanel Grid.Column="0" Margin="0,0,10,0">
 <TextBlock Text="Showroom" Style="{DynamicResource Label}" />
 <ComboBox ItemsSource="{Binding ShowroomList}" SelectedValue="{Binding SelectedShowroomId, Mode=TwoWay}"
 SelectedValuePath="Id" DisplayMemberPath="Name" Height="38" VerticalContentAlignment="Center" />
 </StackPanel>
 <StackPanel Grid.Column="1" Margin="0,0,10,0">
 <TextBlock Text="Staff (optional)" Style="{DynamicResource Label}" />
 <ComboBox ItemsSource="{Binding StaffList}" SelectedValue="{Binding SelectedStaffId, Mode=TwoWay}"
 SelectedValuePath="Id" DisplayMemberPath="FullName" Height="38" VerticalContentAlignment="Center" />
 </StackPanel>
 <StackPanel Grid.Column="2" Margin="0,0,10,0">
 <TextBlock Text="From" Style="{DynamicResource Label}" />
 <DatePicker SelectedDate="{Binding FromDate}" Height="38" VerticalContentAlignment="Center" />
 </StackPanel>
 <StackPanel Grid.Column="3">
 <TextBlock Text="To" Style="{DynamicResource Label}" />
 <DatePicker SelectedDate="{Binding ToDate}" Height="38" VerticalContentAlignment="Center" />
 </StackPanel>
 </Grid>
 </StackPanel>
 </Border>

 <!-- Summary bar -->
 <Border Grid.Row="2" Style="{DynamicResource Card}">
 <StackPanel Orientation="Horizontal">
 <TextBlock Text="{Binding SummaryText}" FontSize="14" FontWeight="SemiBold"
 VerticalAlignment="Center" Margin="0,0,20,0" />
 </StackPanel>
 </Border>

 <!-- Report table -->
 <Border Grid.Row="3" Style="{DynamicResource Card}">
 <DockPanel>
 <TextBlock DockPanel.Dock="Top" Text="Detailed Report" Style="{DynamicResource H2}" />
 <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" BorderThickness="0"
 HeadersVisibility="Column" CanUserAddRows="False" AutoGenerateColumns="False"
 Margin="0,8,0,0">
 <DataGrid.Columns>
 <DataGridTextColumn Header="Date" Binding="{Binding AssignmentDate, StringFormat=dd-MMM-yyyy}" Width="100" />
 <DataGridTextColumn Header="Showroom" Binding="{Binding ShowroomName}" Width="*" />
 <DataGridTextColumn Header="Staff" Binding="{Binding StaffName}" Width="*" />
 <DataGridTextColumn Header="Attendance" Binding="{Binding AttendanceStatus}" Width="80" />
 <DataGridTextColumn Header="Veh In" Binding="{Binding VehiclesAttended}" Width="60" />
 <DataGridTextColumn Header="Veh Done" Binding="{Binding VehiclesCompleted}" Width="70" />
 <DataGridTextColumn Header="Amount" Binding="{Binding AmountGenerated, StringFormat='{}{0:N2}'}" Width="110">
 <DataGridTextColumn.ElementStyle>
 <Style TargetType="TextBlock">
 <Setter Property="HorizontalAlignment" Value="Right" />
 <Setter Property="Margin" Value="0,0,10,0" />
 </Style>
 </DataGridTextColumn.ElementStyle>
 </DataGridTextColumn>
 </DataGrid.Columns>
 </DataGrid>
 </DockPanel>
 </Border>
 </Grid>
</UserControl>
