<Window x:Class="E6CarSpa.Desktop.Views.NewServiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Service" Height="280" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource BgBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Add a new service" Style="{StaticResource H2}" />
        <TextBlock Text="It is added to the catalogue and can be billed straight away."
                   Style="{StaticResource Muted}" Margin="0,0,0,10" />

        <TextBlock Text="Service name" />
        <TextBox x:Name="NameBox" MaxLength="120" />

        <TextBlock Text="Price ₹" Margin="0,8,0,0" />
        <TextBox x:Name="PriceBox" MaxLength="12" PreviewTextInput="Price_PreviewTextInput" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click" />
            <Button Content="Save" Width="100" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
