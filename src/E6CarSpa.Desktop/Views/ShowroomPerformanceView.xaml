<UserControl x:Class="E6CarSpa.Desktop.Views.ShowroomPerformanceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Margin="28">
 <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0,0,10,0">
 <Grid>
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="*" />
 </Grid.RowDefinitions>

 <TextBlock Grid.Row="0" Text="Showroom Performance" Style="{DynamicResource H1}" />

 <!-- Filters -->
 <Border Grid.Row="1" Style="{DynamicResource Card}">
 <StackPanel>
 <TextBlock Text="Select Showroom and Date Range" Style="{DynamicResource H2}" />
 <Grid>
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="2*" />
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="Auto" />
 </Grid.ColumnDefinitions>
 <StackPanel Grid.Column="0" Margin="0,0,10,0">
 <TextBlock Text="Showroom" Style="{DynamicResource Label}" />
 <ComboBox ItemsSource="{Binding ShowroomList}" SelectedValue="{Binding SelectedShowroomId, Mode=TwoWay}"
 SelectedValuePath="Id" DisplayMemberPath="Name" Height="38" VerticalContentAlignment="Center" />
 </StackPanel>
 <StackPanel Grid.Column="1" Margin="0,0,10,0">
 <TextBlock Text="From" Style="{DynamicResource Label}" />
 <DatePicker SelectedDate="{Binding FromDate}" Height="38" VerticalContentAlignment="Center" />
 </StackPanel>
 <StackPanel Grid.Column="2" Margin="0,0,10,0">
 <TextBlock Text="To" Style="{DynamicResource Label}" />
 <DatePicker SelectedDate="{Binding ToDate}" Height="38" VerticalContentAlignment="Center" />
 </StackPanel>
 <StackPanel Grid.Column="3" Margin="10,0,0,10">
 <TextBlock Text=" " Style="{DynamicResource Label}" />
 <Button Content="Refresh" Style="{DynamicResource SecondaryButton}"
 Command="{Binding RefreshCommand}" Height="38" Width="90" Padding="16,6" />
 </StackPanel>
 </Grid>
 <TextBlock Text="{Binding Info}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"
 Margin="0,6,0,0" Visibility="{Binding Info, Converter={StaticResource StringToVis}}" />
 <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
 Margin="0,6,0,0" Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
 </StackPanel>
 </Border>

 <!-- Performance panels -->
 <Grid Grid.Row="2" Margin="0,14,0,0">
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="*" />
 </Grid.ColumnDefinitions>

 <!-- Summary cards -->
 <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,8,0">
 <DockPanel>
 <TextBlock DockPanel.Dock="Top" Text="Summary" Style="{DynamicResource H2}" />
 <ItemsControl ItemsSource="{Binding StatLines}">
 <ItemsControl.ItemsPanel>
 <ItemsPanelTemplate>
 <StackPanel />
 </ItemsPanelTemplate>
 </ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate>
 <Grid Margin="0,2">
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="*" />
 </Grid.ColumnDefinitions>
 <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
 VerticalAlignment="Center" />
 <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold"
 Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </DockPanel>
 </Border>

 <!-- Staff breakdown -->
 <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="0,0,8,0">
 <DockPanel>
 <TextBlock DockPanel.Dock="Top" Text="Staff Performance" Style="{DynamicResource H2}" />
 <DataGrid ItemsSource="{Binding StaffPerformance}" IsReadOnly="True" BorderThickness="0"
 HeadersVisibility="Column" CanUserAddRows="False" AutoGenerateColumns="False">
 <DataGrid.Columns>
 <DataGridTextColumn Header="Staff" Binding="{Binding StaffName}" Width="*" />
 <DataGridTextColumn Header="Days" Binding="{Binding DaysWorked}" Width="50" />
 <DataGridTextColumn Header="Veh" Binding="{Binding TotalVehicles}" Width="50" />
 <DataGridTextColumn Header="Done" Binding="{Binding TotalCompleted}" Width="50" />
 <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" Width="90">
 <DataGridTextColumn.ElementStyle>
 <Style TargetType="TextBlock">
 <Setter Property="HorizontalAlignment" Value="Right" />
 <Setter Property="Margin" Value="0,0,6,0" />
 </Style>
 </DataGridTextColumn.ElementStyle>
 </DataGridTextColumn>
 </DataGrid.Columns>
 </DataGrid>
 </DockPanel>
 </Border>

 <!-- Daily breakdown -->
 <Border Grid.Column="2" Style="{DynamicResource Card}">
 <DockPanel>
 <TextBlock DockPanel.Dock="Top" Text="Daily Breakdown" Style="{DynamicResource H2}" />
 <DataGrid ItemsSource="{Binding DailyBreakdown}" IsReadOnly="True" BorderThickness="0"
 HeadersVisibility="Column" CanUserAddRows="False" AutoGenerateColumns="False">
 <DataGrid.Columns>
 <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MMM}" Width="80" />
 <DataGridTextColumn Header="Staff" Binding="{Binding StaffName}" Width="*" />
 <DataGridTextColumn Header="Veh" Binding="{Binding VehiclesAttended}" Width="45" />
 <DataGridTextColumn Header="Amt" Binding="{Binding AmountGenerated, StringFormat='{}{0:N0}'}" Width="70">
 <DataGridTextColumn.ElementStyle>
 <Style TargetType="TextBlock">
 <Setter Property="HorizontalAlignment" Value="Right" />
 <Setter Property="Margin" Value="0,0,6,0" />
 </Style>
 </DataGridTextColumn.ElementStyle>
 </DataGridTextColumn>
 </DataGrid.Columns>
 </DataGrid>
 </DockPanel>
 </Border>
 </Grid>
 </Grid>
 </ScrollViewer>
</UserControl>
