<UserControl x:Class="E6CarSpa.Desktop.Views.IncomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Income" Style="{StaticResource H1}" />

        <!-- Record a new income entry -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Record an income entry" Style="{StaticResource H2}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Source" />
                        <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0" Width="130">
                        <TextBlock Text="Amount ₹" />
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0" Width="150">
                        <TextBlock Text="Date" />
                        <DatePicker SelectedDate="{Binding IncomeDate}" Height="38"
                                    VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,0" Width="200">
                        <TextBlock Text="Note (optional)" />
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                        <TextBlock Text=" " Opacity="0" />
                        <TextBlock Text="Filter from" Style="{StaticResource Muted}" FontSize="12" />
                        <DatePicker SelectedDate="{Binding FromDate}" Height="30"
                                    VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="5">
                        <TextBlock Text=" " Opacity="0" />
                        <TextBlock Text="Filter to" Style="{StaticResource Muted}" FontSize="12" />
                        <DatePicker SelectedDate="{Binding ToDate}" Height="30"
                                    VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding Info}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Info, Converter={StaticResource StringToVis}}" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="🔄 Refresh" Margin="0,0,10,0"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="200" VerticalContentAlignment="Center"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 ToolTip="Filter by income source" />
                    </StackPanel>

                    <Button Grid.Column="3" Content="➕ Record Income" Width="180"
                            Command="{Binding RecordCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Summary by source -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Income by source" Style="{StaticResource H2}" />
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="15">
                        <Run Text="Total income (selected period): " FontWeight="SemiBold" />
                        <Run Text="{Binding GrandTotal, StringFormat='₹{0:N2}', Mode=OneWay}"
                             FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding Summary}" IsReadOnly="True" BorderThickness="0"
                              HeadersVisibility="Column" CanUserAddRows="False" AutoGenerateColumns="False"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="Entries" Binding="{Binding Count}" Width="80" />
                            <DataGridTextColumn Header="Total ₹" Binding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Full income list -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="All income entries" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox Content="Show deleted" VerticalAlignment="Center" Margin="0,0,12,0"
                                      IsChecked="{Binding ShowDeleted}"
                                      ToolTip="Deleted entries are kept for the record" />
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding Income}" IsReadOnly="True" BorderThickness="0"
                              HeadersVisibility="Column" CanUserAddRows="False" AutoGenerateColumns="False"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding IncomeDate, StringFormat='dd-MM-yyyy'}" Width="110" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="Amount ₹" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="110" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Deleted" Binding="{Binding DeletedCaption}" Width="200"
                                                MinWidth="140" />
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕ Delete" Background="Transparent"
                                                Foreground="{StaticResource DangerBrush}" Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
