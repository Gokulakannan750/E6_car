<Window x:Class="E6CarSpa.Desktop.Views.ShowroomFormView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 SizeToContent="WidthAndHeight" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" MinWidth="420" MaxWidth="550"
 Title="Showroom">
 <Grid Margin="20">
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 </Grid.RowDefinitions>

 <TextBlock Grid.Row="0" Text="Showroom Details" Style="{DynamicResource H2}" Margin="0,0,0,16"/>

 <TextBlock Grid.Row="1" Text="Showroom Name *" Style="{DynamicResource Label}" />
 <TextBox Grid.Row="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

 <TextBlock Grid.Row="3" Text="Address *" Style="{DynamicResource Label}" />
 <TextBox Grid.Row="4" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

 <TextBlock Grid.Row="5" Text="Phone (optional)" Style="{DynamicResource Label}" />
 <TextBox Grid.Row="6" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

 <TextBlock Grid.Row="7" Text="Contact Person (optional)" Style="{DynamicResource Label}" />
 <TextBox Grid.Row="8" Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />

 <TextBlock Grid.Row="9" Text="Notes (optional)" Style="{DynamicResource Label}" />
 <TextBox Grid.Row="10" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

 <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
 <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" />
 <Button Content="Save" Width="80" IsDefault="True" Click="OnSave" />
 </StackPanel>
 </Grid>
</Window>
