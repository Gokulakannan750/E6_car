<UserControl x:Class="E6CarSpa.Desktop.Views.InvoiceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel>
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Margin="0,0,0,4" />
                    <TextBlock FontSize="15">
                        <Run Text="{Binding Invoice.CustomerName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding Invoice.CustomerPhone, Mode=OneWay}" />
                        <Run Text="  ·  Car: " />
                        <Run Text="{Binding Invoice.CarNumber, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" - " />
                        <Run Text="{Binding Invoice.CarModel, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Background="#FFEBEE" CornerRadius="8" Padding="14,8" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Invoice.Status}" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource PrimaryDarkBrush}" />
                </Border>
            </Grid>

            <!-- Add service — only before the invoice is generated; the service lines are
                 locked once it becomes an Invoice (only the discount stays editable after that). -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding IsQuotation, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="4 · Add jobs done" Style="{StaticResource H2}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Catalogue}" SelectedItem="{Binding SelectedService}"
                                  DisplayMemberPath="Name" Margin="0,0,12,0" />
                        <Button Grid.Column="1" Content="➕ Add" Command="{Binding AddServiceCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Line items — editable only before generation (IsQuotation); read-only for both
                 an Invoiced (unpaid) bill and a Paid one, matching the discount/services split below. -->
            <Border Style="{StaticResource Card}">
                <DataGrid ItemsSource="{Binding Lines}" CanUserAddRows="False"
                          IsReadOnly="{Binding IsQuotation, Converter={StaticResource InverseBool}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Service / Item" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70" />
                        <DataGridTextColumn Header="Rate ₹" Binding="{Binding UnitPrice}" Width="100" />
                        <DataGridTextColumn Header="Total ₹" Binding="{Binding LineTotal, StringFormat='{}{0:N2}'}" Width="110" IsReadOnly="True" />
                        <!-- Extra-wide, left-aligned so the button itself never sits under the
                             vertical scrollbar that appears once the lines overflow. -->
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Background="Transparent" Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="6" FontSize="15"
                                            HorizontalAlignment="Left" Margin="4,0,0,0"
                                            Visibility="{Binding DataContext.IsQuotation, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Totals + discount/notes -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="Discount ₹" FontWeight="SemiBold" />
                        <TextBox Width="160" HorizontalAlignment="Left"
                                 Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 IsEnabled="{Binding CanEdit}" />
                        <CheckBox Content="Apply GST (tax)" IsChecked="{Binding ApplyGst}" IsEnabled="{Binding CanEdit}"
                                  Margin="0,8,0,0" ToolTip="Uncheck for a non-GST bill (no tax charged)" />
                        <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Sub Total" FontSize="14" Margin="0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal, StringFormat='₹{0:N2}'}"
                                       FontSize="14" HorizontalAlignment="Right" Margin="0,4" />
                            <TextBlock Grid.Row="1" Text="GST" FontSize="14" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalTax, StringFormat='₹{0:N2}'}"
                                       FontSize="14" HorizontalAlignment="Right" Margin="0,4" />
                            <TextBlock Grid.Row="2" Text="Grand Total" FontWeight="Bold" FontSize="18" Margin="0,6,0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GrandTotal, StringFormat='₹{0:N2}'}"
                                       FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Right" Margin="0,6,0,4" />
                            <TextBlock Grid.Row="3" Text="Discount" FontSize="14" Margin="0,4" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiscountTotal, StringFormat='- ₹{0:N2}'}"
                                       FontSize="14" HorizontalAlignment="Right" Margin="0,4" />
                            <TextBlock Grid.Row="4" Text="Balance" Foreground="{StaticResource DangerBrush}" FontSize="14"
                                       FontWeight="SemiBold" Margin="0,4" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Invoice.Balance, StringFormat='₹{0:N2}'}"
                                       Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Right" Margin="0,4" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                <Button Content="🚫 Cancel Bill" Style="{StaticResource SecondaryButton}" Width="150" Margin="8,0"
                        Foreground="{StaticResource DangerBrush}"
                        Command="{Binding CancelBillCommand}"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                        ToolTip="Marks the bill as Cancelled (needs a Manager or Admin login)" />
                <Button Content="💾 Save Changes" Style="{StaticResource SecondaryButton}" Width="170" Margin="8,0"
                        Command="{Binding SaveChangesCommand}" IsEnabled="{Binding CanEdit}" />
                <Button Content="✅ Generate Invoice" Width="190" Margin="8,0"
                        Command="{Binding FinaliseCommand}"
                        Visibility="{Binding IsQuotation, Converter={StaticResource BoolToVis}}" />
                <!-- Before generation: prints the QUOTATION (customer, car, services). -->
                <Button Content="🖨 Print Quotation" Style="{StaticResource SecondaryButton}" Width="160" Margin="8,0"
                        Command="{Binding PrintCommand}"
                        Visibility="{Binding IsQuotation, Converter={StaticResource BoolToVis}}" />
                <!-- After generation: prints the tax INVOICE. -->
                <Button Content="🖨 Print Invoice" Style="{StaticResource SecondaryButton}" Width="150" Margin="8,0"
                        Command="{Binding PrintCommand}"
                        Visibility="{Binding IsFinalised, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Payment -->
            <Border Style="{StaticResource Card}" Background="#F1F8E9"
                    Visibility="{Binding CanPay, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="5 · Collect Payment" Style="{StaticResource H2}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Method" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Amount ₹" FontWeight="SemiBold" />
                            <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Reference (UPI/Card txn)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Grid.Column="3" Content="💰 Record Payment" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Command="{Binding RecordPaymentCommand}" />
                    </Grid>
                    <TextBlock Text="Tip: enter an amount less than the balance to record a part-payment — the bill stays open with the remaining balance. On full payment, an automatic WhatsApp thank-you is sent."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Payments received (history of all part / full payments) -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding Invoice.Payments.Count, Converter={StaticResource CountToVis}}">
                <StackPanel>
                    <TextBlock Text="Payments received" Style="{StaticResource H2}" />
                    <DataGrid ItemsSource="{Binding Invoice.Payments}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding PaidAt, StringFormat='dd-MM-yyyy HH:mm'}" Width="160" />
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="100" />
                            <DataGridTextColumn Header="Amount ₹" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="120" />
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,6,0,0">
                        <Run Text="Total paid: " FontWeight="SemiBold" />
                        <Run Text="{Binding Invoice.AmountPaid, StringFormat='₹{0:N2}', Mode=OneWay}"
                             FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        <Run Text="   Balance: " FontWeight="SemiBold" />
                        <Run Text="{Binding Invoice.Balance, StringFormat='₹{0:N2}', Mode=OneWay}"
                             FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Info}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="14"
                       Visibility="{Binding Info, Converter={StaticResource StringToVis}}" Margin="0,4" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="14"
                       Visibility="{Binding Error, Converter={StaticResource StringToVis}}" Margin="0,4" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
