<UserControl x:Class="E6CarSpa.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>
            <TextBlock Text="Reports" Style="{StaticResource H1}" />

            <!-- Date range -->
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="From" />
                        <DatePicker SelectedDate="{Binding FromDate}" Width="150" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="To" />
                        <DatePicker SelectedDate="{Binding ToDate}" Width="150" />
                    </StackPanel>
                    <Button Content="Run Report" VerticalAlignment="Bottom" Margin="0,0,0,2"
                            Command="{Binding RunCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>

            <!-- Sales KPIs -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Invoices" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Sales.InvoiceCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sales (incl. GST)" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Sales.GrandTotal, StringFormat='₹{0:N2}'}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Background="#E8F5E9">
                    <StackPanel>
                        <TextBlock Text="Collected" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Sales.Collected, StringFormat='₹{0:N2}'}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Background="#FFF3E0">
                    <StackPanel>
                        <TextBlock Text="Outstanding" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Sales.Outstanding, StringFormat='₹{0:N2}'}" FontSize="22" FontWeight="Bold"
                                   Foreground="#E65100" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Collection split + GST totals -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="Collection by Mode" Style="{StaticResource H2}" />
                        <TextBlock><Run Text="💵 Cash: " /><Run Text="{Binding Sales.Cash, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock><Run Text="💳 Card: " /><Run Text="{Binding Sales.Card, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock><Run Text="📱 UPI: " /><Run Text="{Binding Sales.Upi, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Output GST" Style="{StaticResource H2}" />
                        <TextBlock><Run Text="Taxable value: " /><Run Text="{Binding Sales.TaxableValue, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock><Run Text="CGST: " /><Run Text="{Binding Sales.Cgst, StringFormat='₹{0:N2}', Mode=OneWay}" /><Run Text="   SGST: " /><Run Text="{Binding Sales.Sgst, StringFormat='₹{0:N2}', Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="IGST: " /><Run Text="{Binding Sales.Igst, StringFormat='₹{0:N2}', Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Total tax: " /><Run Text="{Binding Sales.TotalTax, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Daily + Top services -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="Daily Sales" Style="{StaticResource H2}" />
                        <DataGrid ItemsSource="{Binding Daily}" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd-MM-yyyy'}" Width="*" />
                                <DataGridTextColumn Header="Invoices" Binding="{Binding InvoiceCount}" Width="80" />
                                <DataGridTextColumn Header="Sales ₹" Binding="{Binding GrandTotal, StringFormat='{}{0:N2}'}" Width="110" />
                                <DataGridTextColumn Header="Collected ₹" Binding="{Binding Collected, StringFormat='{}{0:N2}'}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Top Services" Style="{StaticResource H2}" />
                        <DataGrid ItemsSource="{Binding TopServices}" Height="200">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTop3}" Value="True">
                                            <Setter Property="Background" Value="#FFF9C4" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Service / Item" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat='{}{0:N0}'}" Width="60" />
                                <DataGridTextColumn Header="Amount ₹" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- GST summary by rate (filing) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="GST Summary by Rate (for filing)" Style="{StaticResource H2}" />
                    <DataGrid ItemsSource="{Binding GstRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, StringFormat='{}{0:N1}'}" Width="80" />
                            <DataGridTextColumn Header="Taxable ₹" Binding="{Binding TaxableValue, StringFormat='{}{0:N2}'}" Width="*" />
                            <DataGridTextColumn Header="CGST ₹" Binding="{Binding Cgst, StringFormat='{}{0:N2}'}" Width="*" />
                            <DataGridTextColumn Header="SGST ₹" Binding="{Binding Sgst, StringFormat='{}{0:N2}'}" Width="*" />
                            <DataGridTextColumn Header="IGST ₹" Binding="{Binding Igst, StringFormat='{}{0:N2}'}" Width="*" />
                            <DataGridTextColumn Header="Total ₹" Binding="{Binding Total, StringFormat='{}{0:N2}'}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Customer history -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Customer History" Style="{StaticResource H2}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="220" Margin="0,0,12,0">
                            <TextBlock Text="Customer phone" />
                            <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Content="🔍 Look up" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                Style="{StaticResource SecondaryButton}" Command="{Binding LookupCustomerCommand}" />
                    </StackPanel>
                    <TextBlock Visibility="{Binding CustomerHistory, Converter={StaticResource NullToVis}}">
                        <Run Text="{Binding CustomerHistory.Name, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="  ·  Visits: " /><Run Text="{Binding CustomerHistory.VisitCount, Mode=OneWay}" />
                        <Run Text="  ·  Lifetime: " /><Run Text="{Binding CustomerHistory.LifetimeValue, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  ·  Outstanding: " /><Run Text="{Binding CustomerHistory.Outstanding, StringFormat='₹{0:N2}', Mode=OneWay}" Foreground="#C62828" />
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding CustomerInvoices}" Height="180" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat='dd-MM-yyyy'}" Width="110" />
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="110" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Car" Binding="{Binding CarNumber}" Width="120" />
                            <DataGridTextColumn Header="Total ₹" Binding="{Binding GrandTotal, StringFormat='{}{0:N2}'}" Width="*" />
                            <DataGridTextColumn Header="Balance ₹" Binding="{Binding Balance, StringFormat='{}{0:N2}'}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource StringToVis}}" Margin="0,4" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
