<UserControl x:Class="E6CarSpa.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
             
    <UserControl.Resources>
        <!-- Clean, Modern DataGrid Styles -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,12,12,12" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel>
            
            <!-- Header Row -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Reports" Style="{StaticResource H1}" VerticalAlignment="Center" />
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="From:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,16,0" Padding="4" />
                    <TextBlock Text="To:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,16,0" Padding="4" />
                    <Button Content="Run Report" Padding="20,8" Command="{Binding RunCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Grid>

            <!-- Sales KPIs -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total Invoices" Foreground="#64748b" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Sales.InvoiceCount}" FontSize="28" FontWeight="Bold" Foreground="#0f172a" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Sales (incl. GST)" Foreground="#64748b" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Sales.GrandTotal, StringFormat='₹{0:N2}'}" FontSize="28" FontWeight="Bold" Foreground="#0f172a" />
                    </StackPanel>
                </Border>
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Collected" Foreground="#166534" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Sales.Collected, StringFormat='₹{0:N2}'}" FontSize="28" FontWeight="Bold" Foreground="#15803D" />
                    </StackPanel>
                </Border>
                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Outstanding" Foreground="#9A3412" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Sales.Outstanding, StringFormat='₹{0:N2}'}" FontSize="28" FontWeight="Bold" Foreground="#C2410C" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Collection split + GST totals -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Collection by Mode" Style="{StaticResource H2}" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="💵" FontSize="16" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Cash" Foreground="#475569" FontSize="15" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Sales.Cash, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Right" />
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="💳" FontSize="16" Margin="0,0,12,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Card" Foreground="#475569" FontSize="15" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Sales.Card, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Right" />
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="📱" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="UPI" Foreground="#475569" FontSize="15" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Sales.Upi, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Output GST" Style="{StaticResource H2}" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Taxable value" Foreground="#475569" FontSize="14" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Sales.TaxableValue, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" />
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CGST + SGST + IGST" Foreground="#475569" FontSize="14" Margin="0,0,0,12" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Sales.TotalTax, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" />
                            
                            <Border Grid.Row="2" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Margin="0,8,0,8" />
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Tax" FontWeight="Bold" FontSize="16" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Sales.TotalTax, StringFormat='₹{0:N2}', Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Daily + Top services -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Daily Sales" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <DataGrid ItemsSource="{Binding Daily}" Height="200" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd-MM-yyyy'}" Width="*" />
                                <DataGridTextColumn Header="Invoices" Binding="{Binding InvoiceCount}" Width="80" />
                                <DataGridTextColumn Header="Sales ₹" Binding="{Binding GrandTotal, StringFormat='{}{0:N2}'}" Width="100" />
                                <DataGridTextColumn Header="Collected ₹" Binding="{Binding Collected, StringFormat='{}{0:N2}'}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Top Services" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <DataGrid ItemsSource="{Binding TopServices}" Height="200" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTop3}" Value="True">
                                            <Setter Property="Background" Value="#FEF08A" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Service / Item" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat='{}{0:N0}'}" Width="60" />
                                <DataGridTextColumn Header="Amount ₹" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>



            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource StringToVis}}" Margin="0,4" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
