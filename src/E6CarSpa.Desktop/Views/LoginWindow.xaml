<Window x:Class="E6CarSpa.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E6 Car Spa — Login" Height="540" Width="440"
        Icon="/E6CarSpa.Desktop;component/Assets/logo.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="16" Margin="12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0A0A" Offset="0" />
                <GradientStop Color="#1A1A1A" Offset="0.5" />
                <GradientStop Color="#D32F2F" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.4" />
        </Border.Effect>

        <Grid Margin="38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="✕" Width="36" Height="36" Click="Close_Click" Cursor="Hand"
                        Foreground="White" FontSize="16" FontWeight="Bold" ToolTip="Close">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cb" Background="#33FFFFFF" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cb" Property="Background" Value="#D32F2F" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="E6 CAR SPA" FontSize="32" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Billing &amp; Workshop Management" Foreground="#CCCCCC"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,30" />

                <Border Background="White" CornerRadius="12" Padding="26">
                    <StackPanel>
                        <TextBlock Text="Username" FontWeight="SemiBold" FontSize="14" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />

                        <TextBlock Text="Password" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,0" />
                        <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown" FontSize="15" />

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,4,0,6"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

                        <Button Content="Sign In" Click="Login_Click" Height="46" FontSize="15" Margin="0,10,0,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Border>


            </StackPanel>
        </Grid>
    </Border>
</Window>
