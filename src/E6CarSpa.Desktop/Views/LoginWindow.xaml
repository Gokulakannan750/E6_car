<Window x:Class="E6CarSpa.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E6 Car Spa — Login" Height="540" Width="440"
        Icon="/E6CarSpa.Desktop;component/Assets/logo.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="16" Background="{DynamicResource PrimaryDarkBrush}">
        <Grid>
            <!-- Close Button -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                    Content="✕" Width="32" Height="32" Click="Close_Click" Cursor="Hand"
                    Foreground="White" FontSize="14" FontWeight="Bold" ToolTip="Close"
                    Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Card -->
            <Border CornerRadius="12" Margin="32,48,32,32" Background="{DynamicResource SurfaceBrush}" BorderThickness="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.2" Color="Black" />
                </Border.Effect>

                <Grid Margin="32">
                    <StackPanel VerticalAlignment="Center">
                        <!-- Logo -->
                        <Image Source="/E6CarSpa.Desktop;component/Assets/logo.png" Height="64" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality" />
                        
                        <TextBlock Text="E6 CAR SPA" Style="{DynamicResource H1}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="Billing &amp; Workshop Management" Style="{DynamicResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,32" FontSize="14" />

                        <StackPanel>
                            <TextBlock Text="Username" Style="{DynamicResource Label}" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Password" Style="{DynamicResource Label}" Margin="0,8,0,4" />
                            <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown" />

                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,4,0,8"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

                            <Button Content="Sign In" Click="Login_Click" Height="44" Margin="0,8,0,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
