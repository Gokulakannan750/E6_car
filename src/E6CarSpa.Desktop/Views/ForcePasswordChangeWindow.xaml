<Window x:Class="E6CarSpa.Desktop.Views.ForcePasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set a new password" Height="380" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Border Padding="28" Background="{StaticResource SurfaceBrush}">
        <StackPanel>
            <TextBlock Text="Set a new password" Style="{StaticResource H1}" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,18" Foreground="{StaticResource MutedBrush}"
                       Text="This account is using a temporary password that was generated automatically. Choose your own password to continue — nothing else can be done until you do." />

            <TextBlock Text="New password" />
            <PasswordBox x:Name="NewBox" Height="34" Padding="8,6" />

            <TextBlock Text="Confirm new password" Margin="0,12,0,0" />
            <PasswordBox x:Name="ConfirmBox" Height="34" Padding="8,6"
                         KeyDown="ConfirmBox_KeyDown" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Margin="0,12,0,0" Visibility="Collapsed" />

            <Button x:Name="SaveButton" Content="Save password and continue" Height="42" Margin="0,20,0,0"
                    Click="Save_Click" />
        </StackPanel>
    </Border>
</Window>
