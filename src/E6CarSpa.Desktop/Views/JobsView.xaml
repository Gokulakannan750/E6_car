<UserControl x:Class="E6CarSpa.Desktop.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Jobs &amp; Invoices" Style="{StaticResource H1}" />

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Search (name / phone / car / invoice no.)" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Search_KeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0" Width="150">
                    <TextBlock Text="Status" />
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Refresh" VerticalAlignment="Bottom" Margin="0,0,0,8"
                        Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Jobs}" SelectionMode="Single"
                      MouseDoubleClick="Jobs_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat='dd-MM-yyyy HH:mm'}" Width="140" />
                    <DataGridTextColumn Header="Invoice No." Binding="{Binding InvoiceNumber}" Width="120" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                    <DataGridTextColumn Header="Car" Binding="{Binding CarNumber}" Width="120" />
                    <DataGridTextColumn Header="Total ₹" Binding="{Binding GrandTotal, StringFormat='{}{0:N2}'}" Width="110" />
                    <DataGridTextColumn Header="Balance ₹" Binding="{Binding Balance, StringFormat='{}{0:N2}'}" Width="110" />
                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Open" Padding="8,4"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
