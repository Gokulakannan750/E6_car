<UserControl x:Class="E6CarSpa.Desktop.Views.ShowroomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="28">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Showroom" Style="{StaticResource H1}" />

        <!-- Tab switcher -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Showrooms" Command="{Binding ShowShowroomsCommand}" Style="{StaticResource SecondaryButton}" Padding="16,8" />
            <Button Content="Visits" Command="{Binding ShowVisitsCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="16,8" />
        </StackPanel>

        <!-- ========================  Showrooms tab  ======================== -->
        <StackPanel Grid.Row="2" Visibility="{Binding IsShowroomsTab, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
            <Button Content="+ Add Showroom" Command="{Binding BeginAddShowroomCommand}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left" Margin="0,0,0,14" />

            <DataGrid ItemsSource="{Binding Showrooms}" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      IsReadOnly="True" RowHeight="34" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="3*" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="1.3*" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="0.7*" />
                    <DataGridTemplateColumn Header="" Width="1.4*" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Command="{Binding DataContext.BeginEditShowroomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,4,0" FontSize="12" />
                                    <Button Content="Delete" Command="{Binding DataContext.DeleteShowroomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,4" Background="#FFF1F1" Foreground="{StaticResource DangerBrush}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- ========================  Visits tab  ======================== -->
        <StackPanel Grid.Row="2" Visibility="{Binding IsVisitsTab, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ComboBox ItemsSource="{Binding ShowroomPickList}" DisplayMemberPath="Name"
                          SelectedValuePath="Id" SelectedValue="{Binding SelectedShowroomFilterId}" Width="220" />
                <Button Content="Show All Showrooms" Command="{Binding LoadSummaryCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
            </StackPanel>

            <!-- Record visit form -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Record a Visit" Style="{StaticResource H2}" />
                    <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto">
                        <ComboBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding ShowroomPickList}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding VisitShowroomId}" Margin="0,0,8,8" />
                        <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding VisitDate}" Margin="8,0,0,8" />

                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding TeamSent}" Margin="0,0,8,8" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VehiclesAttended}" Margin="8,0,0,8" />

                        <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding VisitAmount}" Margin="0,0,8,8" />
                        <Button Grid.Row="2" Grid.Column="1" Content="Save Visit" Command="{Binding RecordVisitCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Visits list -->
            <DataGrid ItemsSource="{Binding Visits}" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      IsReadOnly="True" RowHeight="34" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Showroom" Binding="{Binding ShowroomName}" Width="2*" />
                    <DataGridTextColumn Header="Date" Binding="{Binding VisitDate, StringFormat=dd-MM-yyyy}" Width="1.2*" />
                    <DataGridTextColumn Header="Team Sent" Binding="{Binding TeamSent}" Width="2*" />
                    <DataGridTextColumn Header="Vehicles" Binding="{Binding VehiclesAttended}" Width="1*" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₹{0:N2}'}" Width="1.2*" />
                    <DataGridTemplateColumn Header="" Width="0.7*" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X" Command="{Binding DataContext.DeleteVisitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="6,2" Background="#FFF1F1" Foreground="{StaticResource DangerBrush}" FontSize="11" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Padding="24,10" Margin="0,12,0,0"
                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Info}" Foreground="{StaticResource SuccessBrush}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
