<Window x:Class="E6CarSpa.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:E6CarSpa.Desktop.ViewModels"
        xmlns:views="clr-namespace:E6CarSpa.Desktop.Views"
        Title="E6 Car Spa" Height="860" Width="1220" MinHeight="600" MinWidth="1000"
        Icon="/E6CarSpa.Desktop;component/Assets/logo.ico"
        WindowStartupLocation="Manual" Background="{StaticResource BgBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewJobViewModel}"><views:NewJobView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:JobsViewModel}"><views:JobsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoiceDetailViewModel}"><views:InvoiceDetailView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}"><views:InventoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogueViewModel}"><views:CatalogueView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffAdvancesViewModel}"><views:StaffAdvancesView /></DataTemplate>

        <!-- Navigation button — bright white text on dark sidebar -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="20,13" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Margin="10,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════  Sidebar  ═══════════════ -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0A0A0A" Offset="0" />
                    <GradientStop Color="#1A1A1A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
            <!-- Faint full-height company-logo watermark behind the menu (fills the whole sidebar) -->
            <Image Source="{Binding LogoBytes, Converter={StaticResource BytesToImage}}"
                   Stretch="UniformToFill" Opacity="0.13" IsHitTestVisible="False"
                   Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}" />
            <DockPanel>
                <!-- Branding -->
                <StackPanel DockPanel.Dock="Top" Margin="0,28,0,24">
                    <TextBlock Text="E6 CAR SPA" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Erode" Foreground="#999999" FontSize="13" HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                    <!-- Subtle divider -->
                    <Border Height="1" Background="#333333" Margin="20,18,20,0" />
                </StackPanel>

                <!-- User card + Logout at bottom. Extra bottom margin keeps the card and the
                     credit line clear of the window edge instead of hard against it. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,16,16,24">
                    <Border Background="#222222" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding RoleName}" Foreground="#D32F2F" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Content="🚪  Log out" Click="Logout_Click" Style="{StaticResource NavButton}"
                            Margin="0,6,0,0" Foreground="#E0E8F0"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Powered by Trovotech Solutions" Foreground="#9A9A9A" FontSize="11"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,14,0,0" />
                </StackPanel>

                <!-- Navigation links -->
                <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                    <Button Content="📊  Dashboard" Style="{StaticResource NavButton}" Command="{Binding ShowDashboardCommand}" />
                    <Button Content="👥  Customers" Style="{StaticResource NavButton}" Command="{Binding ShowCustomersCommand}" />
                    <Button Content="➕  New Job" Style="{StaticResource NavButton}" Command="{Binding ShowNewJobCommand}" />
                    <Button Content="🧾  Quotations &amp; Invoices" Style="{StaticResource NavButton}" Command="{Binding ShowJobsCommand}" />
                    <!-- Inventory is under construction — nav hidden until the client wants it.
                         The screen (InventoryView/ViewModel) and API endpoints are still in place;
                         restore this button to bring it back. -->
                    <Button Content="🗂  Catalogue" Style="{StaticResource NavButton}" Command="{Binding ShowCatalogueCommand}" />
                    <Button Content="💵  Staff Advances" Style="{StaticResource NavButton}" Command="{Binding ShowStaffAdvancesCommand}" />
                    <Button Content="📈  Reports" Style="{StaticResource NavButton}" Command="{Binding ShowReportsCommand}" />
                    <Button Content="⚙  Settings" Style="{StaticResource NavButton}" Command="{Binding ShowSettingsCommand}" />
                </StackPanel>
            </DockPanel>
            </Grid>
        </Border>

        <!-- ═══════════════  Content  ═══════════════ -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0" />
    </Grid>
</Window>
