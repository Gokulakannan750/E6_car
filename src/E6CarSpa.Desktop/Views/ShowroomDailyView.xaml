<UserControl x:Class="E6CarSpa.Desktop.Views.ShowroomDailyView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Margin="28">
 <Grid>
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="*" />
 <RowDefinition Height="Auto" />
 </Grid.RowDefinitions>

 <TextBlock Grid.Row="0" Text="Daily Showroom Staff" Style="{DynamicResource H1}" />

 <!-- Showroom selector + Date + Actions -->
 <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,0,0,12">
 <StackPanel>
 <Grid>
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="2*" />
 <ColumnDefinition Width="Auto" />
 <ColumnDefinition Width="Auto" />
 </Grid.ColumnDefinitions>

 <StackPanel Grid.Column="0">
 <TextBlock Text="Select Showroom *" Style="{DynamicResource Label}" />
 <ComboBox ItemsSource="{Binding ShowroomList}" SelectedItem="{Binding SelectedShowroom, Mode=TwoWay}"
 DisplayMemberPath="Name" Height="38" VerticalContentAlignment="Center"
 Margin="0,0,20,0" />
 </StackPanel>

 <StackPanel Grid.Column="1">
 <TextBlock Text="Date" Style="{DynamicResource Label}" />
 <DatePicker SelectedDate="{Binding SelectedDate}" Height="38"
 VerticalContentAlignment="Center" Width="160"
 Margin="0,0,10,0" />
 </StackPanel>

 <StackPanel Grid.Column="2" VerticalAlignment="Center">
 <TextBlock Text="" />
 <Button Content="+ Add Staff" Style="{DynamicResource PrimaryButton}"
 Command="{Binding OpenAddStaffCommand}" Height="38"
 MinWidth="100" Padding="12,4" />
 </StackPanel>
 </Grid>

 <TextBlock Text="{Binding Info}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"
 Margin="0,8,0,0" Visibility="{Binding Info, Converter={StaticResource StringToVis}}" />
 <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
 Margin="0,6,0,0" Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
 </StackPanel>
 </Border>

 <!-- Empty state / Staff table -->
 <Border Grid.Row="2" Style="{DynamicResource Card}">
 <DockPanel>
 <TextBlock DockPanel.Dock="Top" Text="{Binding PanelHeader}" Style="{DynamicResource H2}" />

 <TextBlock Text="Pick a showroom above to see its staff for today."
 Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,40,0,0"
 HorizontalAlignment="Center"
 Visibility="{Binding IsShowroomSelected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

 <DataGrid ItemsSource="{Binding Assignments}" IsReadOnly="True" BorderThickness="0"
 HeadersVisibility="Column" CanUserAddRows="False" AutoGenerateColumns="False"
 Margin="0,8,0,0"
 Visibility="{Binding IsShowroomSelected, Converter={StaticResource BoolToVis}}">
 <DataGrid.Columns>
 <DataGridTextColumn Header="Staff" Binding="{Binding StaffName}" Width="2*" MinWidth="120" />
 <DataGridTextColumn Header="Attendance" Binding="{Binding AttendanceStatus}" Width="100" />
 <DataGridTemplateColumn Header="Vehicles Done" Width="100">
 <DataGridTemplateColumn.CellTemplate>
 <DataTemplate>
 <TextBlock TextAlignment="Center">
 <TextBlock.Text>
 <MultiBinding StringFormat="{}{0}/{1}">
 <Binding Path="VehiclesAttended" />
 <Binding Path="VehiclesCompleted" />
 </MultiBinding>
 </TextBlock.Text>
 </TextBlock>
 </DataTemplate>
 </DataGridTemplateColumn.CellTemplate>
 </DataGridTemplateColumn>
 <DataGridTextColumn Header="Amount" Binding="{Binding AmountGenerated, StringFormat='{}{0:N0}'}" Width="90" />
 <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="2*" MinWidth="100" />
 <DataGridTemplateColumn Header="Actions" Width="140">
 <DataGridTemplateColumn.CellTemplate>
 <DataTemplate>
 <StackPanel Orientation="Horizontal">
 <Button Content="Edit" Width="50" Height="30" Padding="4,2" Margin="0,0,4,0"
 Command="{Binding DataContext.EditAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
 CommandParameter="{Binding}" />
 <Button Content="Del" Width="40" Height="30" Padding="4,2"
 Background="{DynamicResource DangerBrush}" Foreground="White">
 <Button.Style>
 <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
 <Setter Property="Command" Value="{Binding DataContext.DeleteAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
 <Setter Property="CommandParameter" Value="{Binding}" />
 </Style>
 </Button.Style>
 </Button>
 </StackPanel>
 </DataTemplate>
 </DataGridTemplateColumn.CellTemplate>
 </DataGridTemplateColumn>
 </DataGrid.Columns>
 </DataGrid>
 </DockPanel>
 </Border>

 <!-- Summary bar -->
 <Border Grid.Row="3" Style="{DynamicResource Card}" Margin="0,12,0,0">
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
 Visibility="{Binding IsShowroomSelected, Converter={StaticResource BoolToVis}}">
 <TextBlock Text="{Binding SummaryText}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
 VerticalAlignment="Center" />
 </StackPanel>
 </Border>

 <!-- Add Staff Overlay -->
 <Grid Grid.RowSpan="4" Visibility="{Binding IsAddingStaff, Converter={StaticResource BoolToVis}}">
 <Border Style="{DynamicResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="450" Padding="24" Margin="40">
 <Border.Effect>
 <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" />
 </Border.Effect>
 <Grid>
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto" />
 <RowDefinition Height="*" />
 <RowDefinition Height="Auto" />
 </Grid.RowDefinitions>
 <TextBlock Grid.Row="0" Text="Add Staff" Style="{DynamicResource H2}" Margin="0,0,0,16" />
 
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
 <StackPanel>
 <Grid>
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="Auto" />
 </Grid.RowDefinitions>
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="16" />
 <ColumnDefinition Width="*" />
 </Grid.ColumnDefinitions>

 <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
 <TextBlock Text="Select Staff *" Style="{DynamicResource Label}" />
 <ComboBox ItemsSource="{Binding StaffList}" SelectedItem="{Binding SelectedStaff}" DisplayMemberPath="FullName" Height="38" VerticalContentAlignment="Center" />
 </StackPanel>

 <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
 <TextBlock Text="Attendance *" Style="{DynamicResource Label}" />
 <ComboBox ItemsSource="{Binding AttendanceOptions}" SelectedItem="{Binding SelectedAttendance}" Height="38" VerticalContentAlignment="Center" />
 </StackPanel>

 <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
 <TextBlock Text="Vehicles Attended" Style="{DynamicResource Label}" />
 <TextBox Text="{Binding VehiclesAttended}" />
 </StackPanel>
 
 <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
 <TextBlock Text="Vehicles Completed" Style="{DynamicResource Label}" />
 <TextBox Text="{Binding VehiclesCompleted}" />
 </StackPanel>
 
 <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
 <TextBlock Text="Amount Generated" Style="{DynamicResource Label}" />
 <TextBox Text="{Binding AmountGenerated}" />
 </StackPanel>

 <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
 <TextBlock Text="Remarks" Style="{DynamicResource Label}" />
 <TextBox Text="{Binding Remarks}" />
 </StackPanel>
 </Grid>
 <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
 </StackPanel>
 </ScrollViewer>
 
 <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
 <Button Content="Cancel" Style="{DynamicResource SecondaryButton}" Command="{Binding CancelAddStaffCommand}" Width="80" Height="38" Margin="0,0,12,0" />
 <Button Content="Save" Style="{DynamicResource PrimaryButton}" Command="{Binding SaveStaffCommand}" Width="80" Height="38" />
 </StackPanel>
 </Grid>
 </Border>
 </Grid>
 </Grid>
</UserControl>
