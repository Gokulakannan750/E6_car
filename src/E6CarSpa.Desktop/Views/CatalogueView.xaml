<UserControl x:Class="E6CarSpa.Desktop.Views.CatalogueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Catalogue" Style="{StaticResource H1}" />
            <Button Content="➕ New" HorizontalAlignment="Right" Width="100"
                    Style="{StaticResource SecondaryButton}" Command="{Binding NewServiceCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Services list -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Services" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" SelectionMode="Single"
                                  CanUserAddRows="False" IsReadOnly="True" RowHeight="42" MaxHeight="270" VerticalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="Background" Value="#FFF0F0" />
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
                                <DataGridTextColumn Header="Price ₹" Binding="{Binding DefaultPrice, StringFormat='{}{0:N0}'}" Width="100" />
                                <DataGridTextColumn Header="GST%" Binding="{Binding GstRate, StringFormat='{}{0:N0}'}" Width="80" />
                                <DataGridTemplateColumn Header="Status" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Active" />
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Inactive" />
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Edit form -->
                <Border Style="{StaticResource Card}" Background="#F8FAFC">
                    <StackPanel>
                        <TextBlock Text="{Binding ServiceFormTitle}" Style="{StaticResource H2}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Text="Name" />
                                <TextBox Text="{Binding SvcName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Text="Category" />
                                <TextBox Text="{Binding SvcCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Text="Default Price ₹" />
                                <TextBox Text="{Binding SvcPrice, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,4,0,8" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Text="HSN/SAC" />
                                <TextBox Text="{Binding SvcHsn, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Text="GST %" />
                                <TextBox Text="{Binding SvcGst, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,4,0,8" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Text=" " />
                                <CheckBox Content="Active" IsChecked="{Binding SvcActive}" Margin="0,10,0,8" VerticalAlignment="Center" />
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="💾 Save Service" Width="160" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding SaveServiceCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding Info}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                       Visibility="{Binding Info, Converter={StaticResource StringToVis}}" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
