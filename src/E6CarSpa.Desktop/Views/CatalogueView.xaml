<UserControl x:Class="E6CarSpa.Desktop.Views.CatalogueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Catalogue" Style="{StaticResource H1}" />

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- ===== Services & Recipe ===== -->
            <TabItem Header="Services &amp; Recipe">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <!-- Services list + edit form -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <TextBlock Text="Services" Style="{StaticResource H2}" />
                                <Button Content="➕ New" HorizontalAlignment="Right" Width="90"
                                        Style="{StaticResource SecondaryButton}" Command="{Binding NewServiceCommand}" />
                            </Grid>

                            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Background="#F8FAFC">
                                <StackPanel>
                                    <TextBlock Text="{Binding ServiceFormTitle}" Style="{StaticResource H2}" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Name" />
                                            <TextBox Text="{Binding SvcName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Category" />
                                            <TextBox Text="{Binding SvcCategory, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Default Price ₹" />
                                            <TextBox Text="{Binding SvcPrice, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="HSN/SAC" />
                                            <TextBox Text="{Binding SvcHsn, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="GST %" />
                                            <TextBox Text="{Binding SvcGst, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0" VerticalAlignment="Bottom">
                                            <CheckBox Content="Active" IsChecked="{Binding SvcActive}" Margin="0,0,0,10" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Button Content="💾 Save Service" HorizontalAlignment="Left" Width="160"
                                            Command="{Binding SaveServiceCommand}" />
                                </StackPanel>
                            </Border>

                            <DataGrid ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" />
                                    <DataGridTextColumn Header="Price ₹" Binding="{Binding DefaultPrice, StringFormat='{}{0:N0}'}" Width="80" />
                                    <DataGridTextColumn Header="GST%" Binding="{Binding GstRate, StringFormat='{}{0:N0}'}" Width="55" />
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Bill of materials -->
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Recipe / Bill of Materials" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Text="Products consumed (and auto-deducted from stock) when this service is performed." />
                                <TextBlock Margin="0,6,0,0" FontWeight="SemiBold"
                                           Text="{Binding SelectedService.Name, FallbackValue='Select a service →', TargetNullValue='Select a service →'}" />
                            </StackPanel>

                            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Add product" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding Products}" SelectedItem="{Binding BomSelectedProduct}"
                                                  DisplayMemberPath="Name" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Text="{Binding BomQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                        <Button Grid.Column="2" Content="Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddBomLineCommand}" />
                                    </Grid>
                                    <Button Content="💾 Save Recipe" HorizontalAlignment="Left" Width="150" Margin="0,8,0,0"
                                            Command="{Binding SaveBomCommand}" />
                                </StackPanel>
                            </Border>

                            <DataGrid ItemsSource="{Binding Bom}" IsReadOnly="False" CanUserAddRows="False" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Units" Binding="{Binding Quantity}" Width="80" />
                                    <DataGridTemplateColumn Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Background="Transparent" Foreground="{StaticResource DangerBrush}" Padding="4"
                                                        Command="{Binding DataContext.RemoveBomLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Products ===== -->
            <TabItem Header="Products">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <TextBlock Text="Products" Style="{StaticResource H2}" />
                                <Button Content="➕ New" HorizontalAlignment="Right" Width="90"
                                        Style="{StaticResource SecondaryButton}" Command="{Binding NewProductCommand}" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
                                    <DataGridTextColumn Header="In Stock" Binding="{Binding StockQuantity, StringFormat='{}{0:N0}'}" Width="80" />
                                    <DataGridTextColumn Header="Cost ₹" Binding="{Binding UnitCost, StringFormat='{}{0:N2}'}" Width="70" />
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding ProductFormTitle}" Style="{StaticResource H2}" />
                            <TextBlock Text="Name" />
                            <TextBox Text="{Binding PrdName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Category" />
                            <TextBox Text="{Binding PrdCategory, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Reorder Level (units)" />
                            <TextBox Text="{Binding PrdReorder, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Unit Cost ₹" />
                            <TextBox Text="{Binding PrdCost, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="HSN" />
                            <TextBox Text="{Binding PrdHsn, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="GST %" />
                            <TextBox Text="{Binding PrdGst, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Active" IsChecked="{Binding PrdActive}" Margin="0,6" />
                            <Button Content="💾 Save Product" Command="{Binding SaveProductCommand}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="New products start at 0 stock. Add stock from the Inventory tab." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding Info}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                       Visibility="{Binding Info, Converter={StaticResource StringToVis}}" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
