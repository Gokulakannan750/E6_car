<UserControl x:Class="E6CarSpa.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource H1}" />

            <!-- Change my password -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Change My Password" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="Signed in as " /><Run Text="{Binding MyUsername, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="New password" />
                            <PasswordBox x:Name="MyNewPasswordBox" PasswordChanged="MyNewPassword_Changed" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Change Password" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                Command="{Binding ChangeMyPasswordCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Company & GST -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Company &amp; GST Details" Style="{StaticResource H2}" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Business Name" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="GSTIN" />
                            <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Address Line 1" />
                            <TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Address Line 2" />
                            <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="City" />
                            <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Pincode" />
                            <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="State" />
                            <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="State Code (e.g. 33)" />
                            <TextBox Text="{Binding StateCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Phone" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Email" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Invoice Prefix" />
                            <TextBox Text="{Binding InvoicePrefix, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Default GST %" />
                            <TextBox Text="{Binding DefaultGstRate, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                        <Run Text="Last invoice number issued: " /><Run Text="{Binding LastInvoiceSequence, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" (numbers are sequential and never reset)" />
                    </TextBlock>
                    <Button Content="💾 Save Company Settings" HorizontalAlignment="Left" Width="220" Margin="0,10,0,0"
                            Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
            </Border>

            <!-- Company Logo -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Company Logo" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Text="Shown at the top of every invoice / quotation. PNG or JPG; a wide/landscape logo looks best." Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="220" Height="90" BorderBrush="#C5CAD1" BorderThickness="1" Background="White"
                                Margin="0,0,16,0">
                            <Grid>
                                <TextBlock Text="No logo" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                <Image Source="{Binding LogoBytes, Converter={StaticResource BytesToImage}}" Stretch="Uniform" Margin="6"
                                       Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <Button Content="⬆ Upload Logo" Width="160" Click="UploadLogo_Click" />
                            <Button Content="Remove" Width="160" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RemoveLogoCommand}"
                                    Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Users -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Staff Users" Style="{StaticResource H2}" />
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" SelectionMode="Single" Height="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120" />
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Edit Selected User" Style="{StaticResource H2}" />
                                <TextBlock Text="Full name" />
                                <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Role" />
                                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditRole}" />
                                <CheckBox Content="Active" IsChecked="{Binding EditActive}" Margin="0,4" />
                                <TextBlock Text="Reset password (optional)" />
                                <PasswordBox x:Name="EditPasswordBox" PasswordChanged="EditPassword_Changed" />
                                <Button Content="Save User" Style="{StaticResource SecondaryButton}" Command="{Binding SaveUserCommand}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Add New User" Style="{StaticResource H2}" />
                                <TextBlock Text="Full name" />
                                <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Username" />
                                <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Password" />
                                <PasswordBox x:Name="NewPasswordBox" PasswordChanged="NewPassword_Changed" />
                                <TextBlock Text="Role" />
                                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" />
                                <Button Content="➕ Add User" Command="{Binding AddUserCommand}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Info}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                       Visibility="{Binding Info, Converter={StaticResource StringToVis}}" Margin="0,4" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource StringToVis}}" Margin="0,4" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
