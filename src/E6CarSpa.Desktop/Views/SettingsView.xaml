<UserControl x:Class="E6CarSpa.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,16" Grid.Row="0" />

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Company Profile Tab -->
            <TabItem Header="Company Profile">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <!-- Company & GST -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Company &amp; GST Details" Style="{StaticResource H2}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Business Name" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="GSTIN" />
                                        <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Address Line 1" />
                                        <TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Address Line 2" />
                                        <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="City" />
                                        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Pincode" />
                                        <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="State" />
                                        <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="State Code (e.g. 33)" />
                                        <TextBox Text="{Binding StateCode, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Phone" />
                                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Email" />
                                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="GST Invoice Prefix" />
                                        <TextBox Text="{Binding InvoicePrefix, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Prefix for GST tax invoices, e.g. E6/" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Non-GST Prefix (e.g. E6/)" />
                                        <TextBox Text="{Binding NonGstInvoicePrefix, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Enter ONLY the prefix, e.g. E6/ — the year and the 4-digit number are added automatically." />
                                        <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="Next will be: " /><Run Text="{Binding NonGstPreview, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Default GST %" />
                                        <TextBox Text="{Binding DefaultGstRate, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                    <Run Text="GST invoices: " FontWeight="SemiBold" />
                                    <Run Text="{Binding InvoicePrefix, Mode=OneWay}" /><Run Text="{Binding LastInvoiceSequence, Mode=OneWay}" />
                                    <Run Text=" was the last issued (sequential, never resets)." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                                    <Run Text="Non-GST bills: " FontWeight="SemiBold" />
                                    <Run Text="{Binding NonGstInvoicePrefix, Mode=OneWay}" /><Run Text="{Binding LastNonGstYear, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding LastNonGstSequence, Mode=OneWay, StringFormat={}{0:0000}}" />
                                    <Run Text=" was the last issued — a separate series that restarts each year." />
                                </TextBlock>
                                <Button Content="💾 Save Company Settings" HorizontalAlignment="Left" Width="220" Margin="0,10,0,0"
                                        Command="{Binding SaveSettingsCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Company Logo -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Company Logo" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Muted}" Text="Shown at the top of every invoice / quotation. PNG or JPG; a wide/landscape logo looks best." Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="220" Height="90" BorderBrush="#C5CAD1" BorderThickness="1" Background="White" Margin="0,0,16,0">
                                        <Grid>
                                            <TextBlock Text="No logo" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding LogoBytes, Converter={StaticResource BytesToImage}}" Stretch="Uniform" Margin="6"
                                                   Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Content="⬆ Upload Logo" Width="160" Click="UploadLogo_Click" />
                                        <Button Content="Remove" Width="160" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding RemoveLogoCommand}"
                                                Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Account & Security Tab -->
            <TabItem Header="Account &amp; Security">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <!-- Change my password -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Change My Password" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="Signed in as " /><Run Text="{Binding MyUsername, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Old password" />
                                        <PasswordBox x:Name="MyOldPasswordBox" PasswordChanged="MyOldPassword_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="New password" />
                                        <PasswordBox x:Name="MyNewPasswordBox" PasswordChanged="MyNewPassword_Changed" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Change Password" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                            Command="{Binding ChangeMyPasswordCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Staff logins. Admin-only: the tab is hidden for other roles, and the API refuses
                 these calls anyway, so this is convenience rather than the security boundary. -->
            <TabItem Header="Users" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Add a User" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Create a login for a staff member. Give them the password directly — it is never shown again." />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Full name" />
                                        <TextBox Text="{Binding NewUserFullName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Username" />
                                        <TextBox Text="{Binding NewUserUsername, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                        <TextBlock Text="Password (min 8)" />
                                        <PasswordBox x:Name="NewUserPasswordBox" PasswordChanged="NewUserPassword_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                        <TextBlock Text="Role" />
                                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewUserRole}" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="➕ Add User" VerticalAlignment="Bottom"
                                            Margin="0,0,0,16" Command="{Binding CreateUserCommand}" />
                                </Grid>

                                <TextBlock Text="{Binding UserInfo}" Foreground="{StaticResource SuccessBrush}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding UserInfo, Converter={StaticResource StringToVis}}" />
                                <TextBlock Text="{Binding UserError}" Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding UserError, Converter={StaticResource StringToVis}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <TextBlock Text="Staff Logins" Style="{StaticResource H2}" />
                                    <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Command="{Binding LoadUsersCommand}" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding Users}" IsReadOnly="True" BorderThickness="0"
                                          HeadersVisibility="Column" CanUserAddRows="False" AutoGenerateColumns="False"
                                          MinHeight="220" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" MinWidth="140" />
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160" />
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="110" />
                                        <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                                        <DataGridTemplateColumn Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Reset password" Style="{StaticResource SecondaryButton}"
                                                            Padding="10,4" FontSize="12" Margin="0,4"
                                                            HorizontalAlignment="Left" Click="ResetUserPassword_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Enable / Disable" Style="{StaticResource SecondaryButton}"
                                                            Padding="10,4" FontSize="12" Margin="0,4"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.ToggleUserActiveCommand,
                                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{Binding Info}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                       Visibility="{Binding Info, Converter={StaticResource StringToVis}}" Margin="0,4" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource StringToVis}}" Margin="0,4" />
        </StackPanel>
    </Grid>
</UserControl>
