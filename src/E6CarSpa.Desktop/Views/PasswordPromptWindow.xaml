<Window x:Class="E6CarSpa.Desktop.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set password" Height="240" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Border Padding="24" Background="{StaticResource SurfaceBrush}">
        <StackPanel>
            <TextBlock x:Name="PromptText" Style="{StaticResource H2}" TextWrapping="Wrap" />

            <TextBlock Text="New password (min 8 characters)" Margin="0,10,0,0" />
            <PasswordBox x:Name="PasswordBox" Height="32" Padding="8,4" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Margin="0,10,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="100"
                        Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="Set password" Width="130" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
