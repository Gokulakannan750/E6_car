<UserControl x:Class="E6CarSpa.Desktop.Views.NewJobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- On a tall-enough window the content fills the height (Row 2 = "*") and the Services list
         and Bill grid scroll internally. On a short laptop screen the whole page instead scrolls
         (the outer ScrollViewer) so the totals + Save button are never clipped: MinHeight keeps the
         content at least the viewport height, and it grows past that only when it can't fit. -->
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20" MinHeight="{Binding ViewportHeight, ElementName=RootScroll}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="New Job Card" Style="{StaticResource H1}" Margin="0,0,0,8" />

        <!-- Step 1: intake -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="1 · Customer &amp; Vehicle" Style="{StaticResource H2}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Customer Name" />
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Phone" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Car Number" />
                        <TextBox Text="{Binding CarNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" CharacterCasing="Upper" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Car Model" />
                        <TextBox Text="{Binding CarModel, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />
                    </StackPanel>
                    <!-- Same label-then-control stack as the other columns (with an invisible
                         label) so the button lines up exactly with the text boxes, not above them. -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text=" " Opacity="0" />
                        <Button Content="🔍 Look up"
                                Style="{StaticResource SecondaryButton}" Command="{Binding LookupCommand}"
                                ToolTip="Search by Phone or Car Number" />
                    </StackPanel>
                </Grid>
                    <TextBlock Text="Tip: Enter a phone number or car number and click Look up to find an existing customer."
                               Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding LookupInfo}" Style="{StaticResource Muted}" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"
                               Visibility="{Binding LookupInfo, Converter={StaticResource StringToVis}}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding KnownVehicles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                                        BorderThickness="1" BorderBrush="{StaticResource PrimaryBrush}"
                                        Padding="10,4" Margin="0,0,8,0" Cursor="Hand"
                                        Command="{Binding DataContext.SelectVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Content>
                                        <TextBlock>
                                            <Run Text="{Binding CarNumber}" />
                                            <Run Text=" - " />
                                            <Run Text="{Binding CarModel}" />
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Step 2 + 3 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Catalogue -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="2 · Services" Style="{StaticResource H2}" />
                        <TextBlock DockPanel.Dock="Top" Text="Double-click to add to the bill" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <ListBox x:Name="CatalogueList" ItemsSource="{Binding Catalogue}"
                                 SelectedItem="{Binding SelectedService}"
                                 MouseDoubleClick="Catalogue_DoubleClick"
                                 HorizontalContentAlignment="Stretch"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Text="{Binding DefaultPrice, StringFormat='₹{0:N0}'}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Bill -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="130" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="3 · Bill" Style="{StaticResource H2}" />

                        <!-- Line items -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" IsReadOnly="False" CanUserAddRows="False"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Service / Item" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                                <DataGridTextColumn Header="Rate ₹" Binding="{Binding UnitPrice}" Width="90" />
                                <DataGridTextColumn Header="Total ₹" Binding="{Binding LineTotal, StringFormat='{}{0:N2}'}" Width="100" IsReadOnly="True" />
                                <!-- Extra-wide, left-aligned so the button itself never sits under
                                     the vertical scrollbar that appears once the lines overflow. -->
                                <DataGridTemplateColumn Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Background="Transparent" Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Padding="4"
                                                    HorizontalAlignment="Left" Margin="4,0,0,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Totals + actions -->
                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <!-- Discount + Notes stacked, filling the left column -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Discount ₹" Style="{StaticResource Label}" />
                                    <TextBox Width="140" HorizontalAlignment="Left"
                                             Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                    <CheckBox Content="Apply GST (tax)" IsChecked="{Binding ApplyGst}" Margin="0,4,0,0"
                                              ToolTip="Uncheck for a non-GST bill (no tax charged)" />
                                    <TextBlock Text="Notes" Style="{StaticResource Label}" Margin="0,4,0,0" />
                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="50"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                </StackPanel>
                                <!-- Totals in a fixed-width right column — Sub Total lines up
                                     with the Discount label (both top-aligned in this row). -->
                                <Grid Grid.Column="1" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sub Total" Margin="0,2.5" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
                                               Text="{Binding SubTotal, StringFormat='₹{0:N2}'}" Margin="0,2.5" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="GST" Margin="0,5" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
                                               Text="{Binding TotalTax, StringFormat='₹{0:N2}'}" Margin="0,2.5" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Grand Total" FontWeight="Bold" FontSize="16" Margin="0,2.5" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="{Binding GrandTotal, StringFormat='₹{0:N2}'}" Margin="0,2.5" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Discount" Margin="0,2.5" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right"
                                               Text="{Binding DiscountTotal, StringFormat='- ₹{0:N2}'}" Margin="0,2.5" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Balance" FontWeight="Bold" FontSize="16" Margin="0,2.5"
                                               Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"
                                               Foreground="{StaticResource DangerBrush}"
                                               Text="{Binding Balance, StringFormat='₹{0:N2}'}" Margin="0,2.5" />
                                    <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="💾 Save Quotation" 
                                            HorizontalAlignment="Right" Width="200" Height="45" Margin="0,15,0,0"
                                            Command="{Binding SaveQuotationCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                </Grid>
                            </Grid>

                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
