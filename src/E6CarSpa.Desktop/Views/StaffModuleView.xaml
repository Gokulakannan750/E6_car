<UserControl x:Class="E6CarSpa.Desktop.Views.StaffModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:E6CarSpa.Desktop.ViewModels">
    <Border Background="White" CornerRadius="8" Padding="16">
        <DockPanel>
            <!-- Header -->
            <TextBlock Text="STAFF MODULE" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                       DockPanel.Dock="Top" Margin="0,0,0,16"/>

            <!-- Tab row -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <ListBox ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="Transparent" Padding="14,8,14,8" Margin="0,0,4,0" CornerRadius="8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="#F0F3FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Content area -->
            <Border Style="{DynamicResource Card}" Padding="0" CornerRadius="8">
                <ContentControl Content="{Binding CurrentView}" />
            </Border>
        </DockPanel>
    </Border>
</UserControl>
