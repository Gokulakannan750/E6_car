<UserControl x:Class="E6CarSpa.Desktop.Views.StaffSalariesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Staff Salaries" Style="{StaticResource H1}" />

        <!-- Record a new salary payment -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Record a salary payment" Style="{StaticResource H2}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Worker" />
                        <ComboBox ItemsSource="{Binding StaffList}" SelectedItem="{Binding SelectedStaff, Mode=TwoWay}"
                                  DisplayMemberPath="FullName" IsEditable="False" Height="38"
                                  VerticalContentAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="➕" Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                                    Command="{Binding AddStaffCommand}" ToolTip="Add staff member" />
                            <Button Content="✏️" Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                                    Command="{Binding RenameStaffCommand}" CommandParameter="{Binding SelectedStaff}"
                                    ToolTip="Rename selected" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0" Width="130">
                        <TextBlock Text="Amount ₹" />
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0" Width="150">
                        <TextBlock Text="Date" />
                        <DatePicker SelectedDate="{Binding SalaryDate}" Height="38"
                                    VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Note (optional)" />
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text=" " Opacity="0" />
                        <Button Content="➕ Record Salary" Width="180"
                                Command="{Binding RecordSalaryCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Info}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                           Margin="0,6,0,0" Visibility="{Binding Info, Converter={StaticResource StringToVis}}" />
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
            </StackPanel>
        </Border>

        <!-- Totals per worker + the full list -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Total paid per worker" Style="{StaticResource H2}" />
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="15">
                        <Run Text="All workers: " FontWeight="SemiBold" />
                        <Run Text="{Binding GrandTotal, StringFormat='₹{0:N2}', Mode=OneWay}"
                             FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding Summary}" IsReadOnly="True" BorderThickness="0"
                              HeadersVisibility="Column" CanUserAddRows="False" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Worker" Binding="{Binding StaffName}" Width="*" />
                            <DataGridTextColumn Header="Paid" Binding="{Binding Count}" Width="60" />
                            <DataGridTextColumn Header="Total ₹" Binding="{Binding TotalPaid, StringFormat='{}{0:N2}'}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="All salary payments" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox Content="Show deleted" VerticalAlignment="Center" Margin="0,0,12,0"
                                      IsChecked="{Binding ShowDeleted}"
                                      ToolTip="Deleted entries are kept for the record" />
                            <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LoadCommand}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding Salaries}" IsReadOnly="True" BorderThickness="0"
                              HeadersVisibility="Column" CanUserAddRows="False" AutoGenerateColumns="False"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding SalaryDate, StringFormat='dd-MM-yyyy'}" Width="110" />
                            <DataGridTextColumn Header="Worker" Binding="{Binding StaffName}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Amount ₹" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="110" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Deleted" Binding="{Binding DeletedCaption}" Width="220"
                                                MinWidth="140" />
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕ Delete" Background="Transparent"
                                                Foreground="{StaticResource DangerBrush}" Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                                Command="{Binding DataContext.DeleteSalaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
