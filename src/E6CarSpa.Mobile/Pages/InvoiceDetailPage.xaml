<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:E6CarSpa.Mobile.ViewModels"
    x:Class="E6CarSpa.Mobile.Pages.InvoiceDetailPage"
    Title="Invoice"
    BackgroundColor="#0F0F0F">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label x:Name="TitleLabel" TextColor="White" FontSize="20" FontAttributes="Bold" />
            <Label x:Name="CustomerLabel" TextColor="#CCC" FontSize="14" />
            <Label x:Name="CarLabel" TextColor="#888" FontSize="13" />
            <Label x:Name="StatusLabel" TextColor="#B71C1C" FontSize="13" />

            <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,4" />

            <!-- Add a service (edit mode only) -->
            <Grid x:Name="AddRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="ServicePicker" Grid.Column="0" Title="Add a service"
                        TextColor="White" TitleColor="#888" BackgroundColor="#262626"
                        ItemDisplayBinding="{Binding Name}" />
                <Button x:Name="AddButton" Grid.Column="1" Text="Add"
                        BackgroundColor="#333" TextColor="White" Clicked="OnAddServiceClicked" />
            </Grid>

            <!-- Lines -->
            <VerticalStackLayout x:Name="LinesHost" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LineItemVm">
                        <Border BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="12" StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Description}"
                                       TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding UnitPrice, StringFormat='₹{0:N0} each'}"
                                       TextColor="#888" FontSize="12" />
                                <Entry Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                       Text="{Binding Quantity, Mode=TwoWay}" Keyboard="Numeric"
                                       WidthRequest="58" TextColor="White" BackgroundColor="#262626"
                                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                       Text="{Binding LineTotal, StringFormat='₹{0:N0}'}"
                                       TextColor="White" FontSize="15" VerticalOptions="Center"
                                       WidthRequest="74" HorizontalTextAlignment="End" />
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Text="✕"
                                        BackgroundColor="Transparent" TextColor="#FF6B6B"
                                        Padding="0" WidthRequest="32" VerticalOptions="Center"
                                        Clicked="OnRemoveLineClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,4" />

            <Grid x:Name="DiscountRow" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0" Text="Discount ₹" TextColor="#888" VerticalOptions="Center" />
                <Entry x:Name="DiscountEntry" Grid.Column="1" Text="0" Keyboard="Numeric"
                       TextColor="White" BackgroundColor="#262626" TextChanged="OnTotalsInputChanged" />
            </Grid>
            <Editor x:Name="NotesEditor" Placeholder="Notes (optional)" PlaceholderColor="#888"
                    TextColor="White" BackgroundColor="#262626" HeightRequest="60" />
            <Grid x:Name="GstRow" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Grid.Column="0" Text="Apply GST (tax)" TextColor="White" VerticalOptions="Center" />
                <Switch x:Name="GstSwitch" Grid.Column="1" IsToggled="True" OnColor="#B71C1C" Toggled="OnGstToggled" />
            </Grid>

            <!-- Totals -->
            <Border BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Subtotal" TextColor="#888" />
                        <Label Grid.Column="1" x:Name="SubTotalLabel" Text="₹0" TextColor="#CCC" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="GST" TextColor="#888" />
                        <Label Grid.Column="1" x:Name="TaxLabel" Text="₹0" TextColor="#CCC" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Grand total" TextColor="White" FontAttributes="Bold" />
                        <Label Grid.Column="1" x:Name="GrandLabel" Text="₹0" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Balance due" TextColor="#888" />
                        <Label Grid.Column="1" x:Name="BalanceLabel" Text="₹0" TextColor="#FF8A65" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="InfoLabel" TextColor="#7CC47C" FontSize="13" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="#FF6B6B" FontSize="13" IsVisible="False" />

            <!-- Actions -->
            <Button x:Name="SaveButton" Text="Save changes"
                    BackgroundColor="#333" TextColor="White" Clicked="OnSaveClicked" />
            <Button x:Name="FinaliseButton" Text="Generate invoice (finalise)"
                    BackgroundColor="#B71C1C" TextColor="White" FontAttributes="Bold"
                    Clicked="OnFinaliseClicked" />
            <Button x:Name="PdfButton" Text="View PDF"
                    BackgroundColor="#333" TextColor="White" Clicked="OnPdfClicked" />

            <!-- Payment -->
            <Border x:Name="PaymentPanel" BackgroundColor="#161616" StrokeThickness="0" Padding="14"
                    StrokeShape="RoundRectangle 12" Margin="0,6,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Record payment" TextColor="White" FontSize="16" FontAttributes="Bold" />
                    <Picker x:Name="MethodPicker" Title="Method" TextColor="White" TitleColor="#888"
                            BackgroundColor="#262626" />
                    <Entry x:Name="AmountEntry" Placeholder="Amount" PlaceholderColor="#888"
                           Keyboard="Numeric" TextColor="White" BackgroundColor="#262626" />
                    <Entry x:Name="ReferenceEntry" Placeholder="Reference (optional)" PlaceholderColor="#888"
                           TextColor="White" BackgroundColor="#262626" />
                    <Button x:Name="PayButton" Text="Take payment"
                            BackgroundColor="#B71C1C" TextColor="White" FontAttributes="Bold"
                            Clicked="OnPayClicked" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="#B71C1C" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
