<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:E6CarSpa.Mobile.ViewModels"
    xmlns:c="clr-namespace:E6CarSpa.Contracts;assembly=E6CarSpa.Contracts"
    x:Class="E6CarSpa.Mobile.Pages.InvoiceDetailPage"
    Title="Invoice"
   >

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label x:Name="TitleLabel" FontSize="20" FontAttributes="Bold" />
            <Label x:Name="CustomerLabel" FontSize="14" />
            <Label x:Name="CarLabel" FontSize="13" />
            <Label x:Name="StatusLabel" FontSize="13" />

            <BoxView HeightRequest="1" Margin="0,4" />

            <!-- Add a service (edit mode only) -->
            <Grid x:Name="AddRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="ServicePicker" Grid.Column="0" Title="Add a service"
                        TitleColor="#888"
                        ItemDisplayBinding="{Binding Name}" />
                <Button x:Name="AddButton" Grid.Column="1" Text="Add"
                        Clicked="OnAddServiceClicked" />
            </Grid>

            <!-- Lines -->
            <VerticalStackLayout x:Name="LinesHost" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LineItemVm">
                        <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="12" StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Description}"
                                       FontSize="15" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding UnitPrice, StringFormat='₹{0:N0} each'}"
                                       FontSize="12" />
                                <Entry Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                       Text="{Binding Quantity, Mode=TwoWay}" Keyboard="Numeric"
                                       WidthRequest="58" IsEnabled="{Binding IsEditable}"
                                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                       Text="{Binding Taxable, StringFormat='₹{0:N0}'}"
                                       FontSize="15" VerticalOptions="Center"
                                       WidthRequest="74" HorizontalTextAlignment="End" />
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Text="✕"
                                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}"
                                        Padding="0" WidthRequest="32" VerticalOptions="Center"
                                        IsVisible="{Binding IsEditable}"
                                        Clicked="OnRemoveLineClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Margin="0,4" />

            <Grid x:Name="DiscountRow" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0" Text="Discount ₹" VerticalOptions="Center" />
                <Entry x:Name="DiscountEntry" Grid.Column="1" Text="0" Keyboard="Numeric"
                       TextChanged="OnTotalsInputChanged" />
            </Grid>
            <Editor x:Name="NotesEditor" Placeholder="Notes (optional)"
                    HeightRequest="60" />
            <Grid x:Name="GstRow" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Grid.Column="0" Text="Apply GST (tax)" VerticalOptions="Center" />
                <Switch x:Name="GstSwitch" Grid.Column="1" IsToggled="True" OnColor="{StaticResource Primary}" Toggled="OnGstToggled" />
            </Grid>

            <!-- Totals -->
            <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Subtotal" />
                        <Label Grid.Column="1" x:Name="SubTotalLabel" Text="₹0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="GST" />
                        <Label Grid.Column="1" x:Name="TaxLabel" Text="₹0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Grand total" FontAttributes="Bold" />
                        <Label Grid.Column="1" x:Name="GrandLabel" Text="₹0" FontSize="18" FontAttributes="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Discount" />
                        <Label Grid.Column="1" x:Name="DiscountLabel" Text="- ₹0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Balance due" />
                        <Label Grid.Column="1" x:Name="BalanceLabel" Text="₹0" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource Warning}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="InfoLabel" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource Success}}" FontSize="13" IsVisible="False" />
            <Label x:Name="ErrorLabel" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}" FontSize="13" IsVisible="False" />

            <!-- Actions -->
            <Button x:Name="SaveButton" Text="Save changes"
                    Clicked="OnSaveClicked" />
            <Button x:Name="FinaliseButton" Text="Generate invoice (finalise)"
                    FontAttributes="Bold"
                    Clicked="OnFinaliseClicked" />
            <Button x:Name="PdfButton" Text="View PDF"
                    Clicked="OnPdfClicked" />
            <Button x:Name="CancelBillButton" Text="Cancel bill"
                    BackgroundColor="Transparent" BorderWidth="1"
                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}"
                    BorderColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}"
                    Clicked="OnCancelBillClicked" />

            <!-- Payment -->
            <Border Style="{StaticResource CardBorder}" x:Name="PaymentPanel" StrokeThickness="0" Padding="14"
                    StrokeShape="RoundRectangle 12" Margin="0,6,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Record payment" FontSize="16" FontAttributes="Bold" />
                    <Picker x:Name="MethodPicker" Title="Method" TitleColor="#888"
                            />
                    <Entry x:Name="AmountEntry" Placeholder="Amount"
                           Keyboard="Numeric" />
                    <Entry x:Name="ReferenceEntry" Placeholder="Reference (optional)"
                           />
                    <Button x:Name="PayButton" Text="Take payment"
                            FontAttributes="Bold"
                            Clicked="OnPayClicked" />
                    <Label Text="Tip: enter less than the balance for a part-payment — the bill stays open. On full payment a WhatsApp thank-you is sent."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Payments received (history of all part / full payments) -->
            <Border Style="{StaticResource CardBorder}" x:Name="PaymentsHistoryPanel" StrokeThickness="0" Padding="14"
                    StrokeShape="RoundRectangle 12" Margin="0,6,0,0" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Payments received" FontSize="16" FontAttributes="Bold" />
                    <VerticalStackLayout x:Name="PaymentsHost" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="c:PaymentDto">
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding PaidAt, StringFormat='{0:dd-MM-yyyy HH:mm}'}" FontSize="12" />
                                        <Label Grid.Column="1" Text="{Binding Method}" FontSize="12" />
                                        <Label Grid.Column="2" Text="{Binding Amount, StringFormat='₹{0:N0}'}" FontSize="12" FontAttributes="Bold" />
                                    </Grid>
                                    <Label Text="{Binding Reference}" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label x:Name="PaidSummaryLabel" FontSize="13" FontAttributes="Bold" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
