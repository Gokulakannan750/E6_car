<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:E6CarSpa.Mobile.ViewModels"
    x:Class="E6CarSpa.Mobile.Pages.NewJobPage"
    Title="New Job"
   >

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Customer + car -->
            <Label Text="Customer" FontSize="16" FontAttributes="Bold" />
            <Entry x:Name="NameEntry" Placeholder="Customer name"
                   />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="PhoneEntry" Grid.Column="0" Placeholder="Phone"
                       Keyboard="Telephone" />
                <Button x:Name="LookupButton" Grid.Column="1" Text="Look up"
                        Clicked="OnLookupClicked" />
            </Grid>
            <Entry x:Name="CarNumberEntry" Placeholder="Car number"
                   />
            <Entry x:Name="CarModelEntry" Placeholder="Car model (optional)"
                   />
            <Label x:Name="LookupInfo" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource Success}}" FontSize="13" IsVisible="False" />

            <BoxView HeightRequest="1" Margin="0,4" />

            <!-- Add a service -->
            <Label Text="Services" FontSize="16" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="ServicePicker" Grid.Column="0" Title="Select a service"
                        TitleColor="#888"
                        ItemDisplayBinding="{Binding Name}" />
                <Button x:Name="AddButton" Grid.Column="1" Text="Add"
                        Clicked="OnAddServiceClicked" />
            </Grid>

            <!-- Chosen lines -->
            <VerticalStackLayout x:Name="LinesHost" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LineItemVm">
                        <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="12" StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Description}"
                                       FontSize="15" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding UnitPrice, StringFormat='₹{0:N0} each'}"
                                       FontSize="12" />
                                <Entry Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                       Text="{Binding Quantity, Mode=TwoWay}" Keyboard="Numeric"
                                       WidthRequest="58"
                                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                       Text="{Binding LineTotal, StringFormat='₹{0:N0}'}"
                                       FontSize="15" VerticalOptions="Center"
                                       WidthRequest="74" HorizontalTextAlignment="End" />
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Text="✕"
                                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}"
                                        Padding="0" WidthRequest="32" VerticalOptions="Center"
                                        Clicked="OnRemoveLineClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label x:Name="NoLinesLabel" Text="No services added yet." FontSize="13" />

            <BoxView HeightRequest="1" Margin="0,4" />

            <!-- Discount / notes / GST -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0" Text="Discount ₹" VerticalOptions="Center" />
                <Entry x:Name="DiscountEntry" Grid.Column="1" Text="0" Keyboard="Numeric"
                       TextChanged="OnTotalsInputChanged" />
            </Grid>
            <Editor x:Name="NotesEditor" Placeholder="Notes (optional)"
                    HeightRequest="70" />
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Grid.Column="0" Text="Apply GST (tax)" VerticalOptions="Center" />
                <Switch x:Name="GstSwitch" Grid.Column="1" IsToggled="True"
                        OnColor="#B71C1C" Toggled="OnGstToggled" />
            </Grid>

            <!-- Totals -->
            <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Subtotal" />
                        <Label Grid.Column="1" x:Name="SubTotalLabel" Text="₹0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="GST" />
                        <Label Grid.Column="1" x:Name="TaxLabel" Text="₹0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Grand total" FontAttributes="Bold" />
                        <Label Grid.Column="1" x:Name="GrandLabel" Text="₹0" FontSize="18" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="ErrorLabel" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}" FontSize="13" IsVisible="False" />
            <Button x:Name="SaveButton" Text="Save quotation"
                    FontAttributes="Bold"
                    HeightRequest="50" Clicked="OnSaveClicked" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
