<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E6CarSpa.Mobile.Pages.LoginPage"
   
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="16" VerticalOptions="Center">

            <Label Text="E6 CAR SPA"
                   FontSize="34" FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Billing Terminal"
                   FontSize="16"
                   HorizontalOptions="Center" Margin="0,0,0,12" />

            <Entry x:Name="UsernameEntry"
                   Placeholder="Username"
                  
                   ReturnType="Next" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,0">
                <Entry x:Name="PasswordEntry"
                       Placeholder="Password"
                       Grid.Column="0" Grid.ColumnSpan="2"
                       IsPassword="True" ReturnType="Go"
                       Completed="OnLoginClicked" />
                
                <ImageButton x:Name="TogglePasswordBtn"
                             Grid.Column="1"
                             Source="icon_eye.png"
                             BackgroundColor="Transparent"
                             WidthRequest="24" HeightRequest="24"
                             Margin="0,0,12,0"
                             Clicked="OnTogglePasswordClicked"
                             VerticalOptions="Center" />
            </Grid>

            <Label Text="Server address" FontSize="12" Margin="2,8,0,0" />
            <Entry x:Name="ServerEntry"
                   Placeholder="https://api.yourshop.com"
                  
                   Keyboard="Url" />

            <Label x:Name="ErrorLabel"
                   TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}" IsVisible="False"
                   FontSize="13" Margin="2,4,0,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0" ColumnSpacing="12">
                <Button x:Name="LoginButton"
                        Text="Sign In"
                        Grid.Column="0"
                        FontAttributes="Bold" HeightRequest="50"
                        Clicked="OnLoginClicked" />
                
                <ImageButton x:Name="BiometricButton"
                             Grid.Column="1"
                             Source="icon_fingerprint.png"
                             BackgroundColor="{StaticResource Primary}"
                             CornerRadius="8"
                             Padding="12"
                             WidthRequest="50" HeightRequest="50"
                             Clicked="OnBiometricClicked"
                             IsVisible="False" />
            </Grid>

            <ActivityIndicator x:Name="Busy"
                               IsRunning="False" IsVisible="False"
                               />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
