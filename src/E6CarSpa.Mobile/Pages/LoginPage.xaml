<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E6CarSpa.Mobile.Pages.LoginPage"
   
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center">

            <!-- Brand logo. It's artwork on a black band, so it sits in a black rounded plate
                 (logo_badge.png is logo.png cropped to just the artwork). -->
            <Border BackgroundColor="#000000" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    Padding="18,14" HorizontalOptions="Center" Margin="0,0,0,2">
                <Image Source="logo_badge.png" Aspect="AspectFit"
                       WidthRequest="240" HeightRequest="52" />
            </Border>
            <Label Text="Billing Terminal"
                   FontSize="15"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   HorizontalOptions="Center" Margin="0,0,0,6" />

            <!-- The sign-in form sits in a card so the screen reads as designed, not bare. -->
            <Border Style="{StaticResource CardBorder}" Padding="20" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="16">

                    <Entry x:Name="UsernameEntry"
                           Placeholder="Username"
                           ReturnType="Next" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="PasswordEntry"
                               Placeholder="Password"
                               Grid.Column="0" Grid.ColumnSpan="2"
                               IsPassword="True" ReturnType="Go"
                               Completed="OnLoginClicked" />

                        <ImageButton x:Name="TogglePasswordBtn"
                                     Grid.Column="1"
                                     Source="icon_eye.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="24" HeightRequest="24"
                                     Margin="0,0,4,0"
                                     Clicked="OnTogglePasswordClicked"
                                     VerticalOptions="Center" />
                    </Grid>

                    <Label Text="Server address" FontSize="12" Margin="2,6,0,0"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    <Entry x:Name="ServerEntry"
                           Placeholder="https://api.yourshop.com"
                           Keyboard="Url" />

                    <Label x:Name="ErrorLabel"
                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}" IsVisible="False"
                           FontSize="13" Margin="2,0,0,0" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" ColumnSpacing="12">
                        <Button x:Name="LoginButton"
                                Text="Sign In"
                                Grid.Column="0"
                                FontAttributes="Bold" HeightRequest="50"
                                Clicked="OnLoginClicked" />

                        <ImageButton x:Name="BiometricButton"
                                     Grid.Column="1"
                                     Source="icon_fingerprint.png"
                                     BackgroundColor="{StaticResource Primary}"
                                     CornerRadius="10"
                                     Padding="12"
                                     WidthRequest="50" HeightRequest="50"
                                     Clicked="OnBiometricClicked"
                                     IsVisible="False" />
                    </Grid>

                    <ActivityIndicator x:Name="Busy"
                                       IsRunning="False" IsVisible="False" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
