<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:conv="clr-namespace:E6CarSpa.Mobile.Converters"
 x:Class="E6CarSpa.Mobile.Pages.ShowroomPage"
 Title="Showroom">

 <ContentPage.Resources>
 <conv:InverseBoolConverter x:Key="Not" />
 </ContentPage.Resources>

 <ContentPage.ToolbarItems>
 <ToolbarItem Text="Settings" IconImageSource="icon_settings.png" Clicked="OnSettingsClicked" />
 </ContentPage.ToolbarItems>

 <ScrollView>
 <VerticalStackLayout Padding="16" Spacing="12">

 <Border StrokeThickness="1" Padding="3" StrokeShape="RoundRectangle 9"
 Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
 BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
 <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="3">
 <Button x:Name="TabShowrooms" Grid.Column="0" Text="Showrooms" FontSize="13" HeightRequest="38" CornerRadius="6" Padding="0" Clicked="OnTabShowrooms" />
 <Button x:Name="TabDaily" Grid.Column="1" Text="Daily" FontSize="13" HeightRequest="38" CornerRadius="6" Padding="0" Clicked="OnTabDaily" />
 <Button x:Name="TabPerformance" Grid.Column="2" Text="Performance" FontSize="13" HeightRequest="38" CornerRadius="6" Padding="0" Clicked="OnTabPerformance" />
 <Button x:Name="TabReports" Grid.Column="3" Text="Reports" FontSize="13" HeightRequest="38" CornerRadius="6" Padding="0" Clicked="OnTabReports" />
 </Grid>
 </Border>

 <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />
 <Label x:Name="ErrorLabel" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}" FontSize="13" IsVisible="False" />

 <VerticalStackLayout x:Name="ShowroomsPanel" Spacing="10">
 <Entry x:Name="SearchEntry" Placeholder="Search showrooms..." TextChanged="OnSearchChanged" />
 <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
 <Switch x:Name="ShowInactiveSwitch" Grid.Column="0" OnColor="{StaticResource Primary}" Toggled="OnShowInactiveToggled" />
 <Button x:Name="AddShowroomBtn" Grid.Column="1" Text="+ Add" FontAttributes="Bold" HeightRequest="40" Clicked="OnAddShowroom" />
 </Grid>
 <CollectionView x:Name="ShowroomsList" Margin="0,4,0,0">
 <CollectionView.ItemTemplate>
 <DataTemplate>
 <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="14" Margin="0,0,0,8" StrokeShape="RoundRectangle 10">
 <VerticalStackLayout Spacing="3">
 <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
 <Label Text="{Binding Address}" FontSize="13" />
 <Grid ColumnDefinitions="*,Auto">
 <Label Grid.Column="0" Text="{Binding ContactPerson}" FontSize="12" />
 <Label Grid.Column="1" Text="{Binding IsActive, StringFormat='{}{0:Active}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
 </Grid>
 <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
 <Button Text="Edit" Clicked="OnEditShowroom" CommandParameter="{Binding}" HeightRequest="34" WidthRequest="60" Padding="4,2" />
 <Button Text="{Binding IsActive, StringFormat='{}{0}'}" Clicked="OnToggleShowroom" CommandParameter="{Binding}" HeightRequest="34" WidthRequest="70" Padding="4,2"
 BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" TextColor="White" />
 </Grid>
 </VerticalStackLayout>
 </Border>
 </DataTemplate>
 </CollectionView.ItemTemplate>
 </CollectionView>
 <Label x:Name="NoShowroomsLabel" Text="No showrooms yet." FontSize="14" IsVisible="False" HorizontalOptions="Center" />
 </VerticalStackLayout>

 <VerticalStackLayout x:Name="DailyPanel" Spacing="10" IsVisible="False">
 <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
 <VerticalStackLayout>
 <Label Text="Showroom" FontSize="12" />
 <Picker x:Name="ShowroomPicker" Title="Select showroom" HeightRequest="44" SelectedIndexChanged="OnShowroomPickerChanged" />
 </VerticalStackLayout>
 <VerticalStackLayout>
 <Label Text="Date" FontSize="12" />
 <DatePicker x:Name="DailyDatePicker" Format="dd MMM yyyy" />
 </VerticalStackLayout>
 </Grid>
 <Button x:Name="AddStaffBtn" Text="+ Add Staff" FontAttributes="Bold" HeightRequest="44" Clicked="OnAddStaff" />
 <CollectionView x:Name="DailyStaffList" Margin="0,4,0,0">
 <CollectionView.ItemTemplate>
 <DataTemplate>
 <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="14" Margin="0,0,0,8" StrokeShape="RoundRectangle 10">
 <Grid ColumnDefinitions="2*,Auto,Auto" ColumnSpacing="10">
 <VerticalStackLayout Grid.Column="0" Spacing="2">
 <Label Text="{Binding StaffName}" FontSize="15" FontAttributes="Bold" />
 <Label Text="{Binding AttendanceStatus}" FontSize="12" />
 <Label Text="{Binding Remarks}" FontSize="12" IsVisible="{Binding Remarks, Converter={StaticResource Not}}" />
 </VerticalStackLayout>
 <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
 <Label Text="{Binding VehiclesAttended, StringFormat='{}{0} in'}" FontSize="13" />
 <Label Text="{Binding VehiclesCompleted, StringFormat='{}{0} done'}" FontSize="13" />
 <Label Text="{Binding AmountGenerated, StringFormat='₹{0:N0}'}" FontSize="14" FontAttributes="Bold" />
 </VerticalStackLayout>
 <Button Grid.Column="2" Text="X" Clicked="OnDeleteDaily" CommandParameter="{Binding}" HeightRequest="34" WidthRequest="36" Padding="0"
 BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}" />
 </Grid>
 </Border>
 </DataTemplate>
 </CollectionView.ItemTemplate>
 </CollectionView>
 <Label x:Name="NoDailyLabel" Text="Pick a showroom above." FontSize="14" IsVisible="False" HorizontalOptions="Center" />
 </VerticalStackLayout>

 <VerticalStackLayout x:Name="PerformancePanel" Spacing="10" IsVisible="False">
 <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
 <VerticalStackLayout>
 <Label Text="Showroom" FontSize="12" />
 <Picker x:Name="PerfShowroomPicker" Title="Select showroom" HeightRequest="44" />
 </VerticalStackLayout>
 <VerticalStackLayout>
 <Label Text="From" FontSize="12" />
 <DatePicker x:Name="PerfFromPicker" Format="dd MMM yyyy" />
 </VerticalStackLayout>
 </Grid>
 <VerticalStackLayout>
 <Label Text="To" FontSize="12" />
 <DatePicker x:Name="PerfToPicker" Format="dd MMM yyyy" />
 </VerticalStackLayout>
 <Button Text="Load performance" Clicked="OnLoadPerformance" HeightRequest="44" />

 <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="16" StrokeShape="RoundRectangle 12">
 <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
 <VerticalStackLayout Grid.Column="0" Spacing="4">
 <Label Text="Vehicles" FontSize="12" />
 <Label x:Name="PerfVehicles" Text="-" FontSize="22" FontAttributes="Bold" />
 </VerticalStackLayout>
 <VerticalStackLayout Grid.Column="1" Spacing="4">
 <Label Text="Completed" FontSize="12" />
 <Label x:Name="PerfCompleted" Text="-" FontSize="22" FontAttributes="Bold" />
 </VerticalStackLayout>
 <VerticalStackLayout Grid.Column="2" Spacing="4">
 <Label Text="Amount" FontSize="12" />
 <Label x:Name="PerfAmount" Text="-" FontSize="22" FontAttributes="Bold" />
 </VerticalStackLayout>
 </Grid>
 </Border>

 <Label Text="Per-staff breakdown" FontAttributes="Bold" Margin="0,8,0,0" />
 <CollectionView x:Name="StaffPerfList">
 <CollectionView.ItemTemplate>
 <DataTemplate>
 <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="12" Margin="0,0,0,6" StrokeShape="RoundRectangle 8">
 <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
 <Label Grid.Column="0" Text="{Binding StaffName}" FontSize="14" FontAttributes="Bold" />
 <Label Grid.Column="1" Text="{Binding DaysWorked, StringFormat='{}{0} days'}" FontSize="13" />
 <Label Grid.Column="2" Text="{Binding TotalAmount, StringFormat='₹{0:N2}'}" FontSize="14" FontAttributes="Bold" />
 </Grid>
 </Border>
 </DataTemplate>
 </CollectionView.ItemTemplate>
 </CollectionView>
 <Label x:Name="NoPerfLabel" Text="Load performance data above." FontSize="14" IsVisible="False" />
 </VerticalStackLayout>

 <VerticalStackLayout x:Name="ReportsPanel" Spacing="10" IsVisible="False">
 <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
 <VerticalStackLayout>
 <Label Text="From" FontSize="12" />
 <DatePicker x:Name="ReportFromPicker" Format="dd MMM yyyy" />
 </VerticalStackLayout>
 <VerticalStackLayout>
 <Label Text="To" FontSize="12" />
 <DatePicker x:Name="ReportToPicker" Format="dd MMM yyyy" />
 </VerticalStackLayout>
 </Grid>
 <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
 <Label Grid.Column="0" Text="Showroom" FontSize="12" />
 <Picker x:Name="ReportShowroomPicker" Grid.Column="1" Title="All" HeightRequest="44" />
 </Grid>
 <Button Text="Load report" Clicked="OnLoadReport" HeightRequest="44" />

 <CollectionView x:Name="ReportList" Margin="0,4,0,0">
 <CollectionView.ItemTemplate>
 <DataTemplate>
 <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="12" Margin="0,0,0,6" StrokeShape="RoundRectangle 8">
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
 <VerticalStackLayout Grid.Column="0" Spacing="1">
 <Label Text="{Binding ShowroomName}" FontSize="14" FontAttributes="Bold" />
 <Label Text="{Binding StaffName}" FontSize="13" />
 <Label Text="{Binding AttendanceStatus}" FontSize="12" />
 <Label Text="{Binding AssignmentDate, StringFormat='{}{0:dd-MM-yyyy}'}" FontSize="11" />
 </VerticalStackLayout>
 <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
 <Label Text="{Binding VehiclesAttended, StringFormat='{}{0} in'}" FontSize="12" />
 <Label Text="{Binding VehiclesCompleted, StringFormat='{}{0} done'}" FontSize="12" />
 <Label Text="{Binding AmountGenerated, StringFormat='₹{0:N0}'}" FontSize="14" FontAttributes="Bold" />
 </VerticalStackLayout>
 </Grid>
 </Border>
 </DataTemplate>
 </CollectionView.ItemTemplate>
 </CollectionView>
 <Label x:Name="NoReportLabel" Text="Load report data above." FontSize="14" IsVisible="False" />
 </VerticalStackLayout>

 </VerticalStackLayout>
 </ScrollView>
</ContentPage>
