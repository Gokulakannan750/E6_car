<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E6CarSpa.Mobile.Pages.DashboardPage"
    Title="Dashboard"
   >

    <RefreshView x:Name="Refresh" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Label x:Name="DateLabel" FontSize="13" />

                <!-- Collected today -->
                <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="18"
                        StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Collected Today" FontSize="14" />
                        <Label x:Name="CollectedLabel" Text="₹0"
                               FontSize="34" FontAttributes="Bold" />
                        <Label x:Name="SplitLabel" FontSize="13" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Count tiles -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Style="{StaticResource CardBorder}" Grid.Row="0" Grid.Column="0" StrokeThickness="0"
                            Padding="16" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E3A8A}">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="JobsLabel" Text="0" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#93C5FD}" />
                            <Label Text="Jobs today" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark=#BFDBFE}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Grid.Row="0" Grid.Column="1" StrokeThickness="0"
                            Padding="16" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#FFFBEB, Dark=#78350F}">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="QuotationsLabel" Text="0" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark=#FDE68A}" />
                            <Label Text="Quotations pending" FontSize="13" TextColor="{AppThemeBinding Light=#B45309, Dark=#FEF3C7}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Grid.Row="1" Grid.Column="0" StrokeThickness="0"
                            Padding="16" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#7F1D1D}">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="UnpaidLabel" Text="0" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark=#FECACA}" />
                            <Label Text="Invoices unpaid" FontSize="13" TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FEE2E2}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Grid.Row="1" Grid.Column="1" StrokeThickness="0"
                            Padding="16" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLowStockTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="LowStockLabel" Text="0" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource Warning}}" FontSize="26" FontAttributes="Bold" />
                            <Label Text="Low-stock items  ›" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Staff advances live on their own page (no counts on the dashboard payload). -->
                <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="16"
                        StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAdvancesTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Staff Advances" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Cash given to workers" FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="22" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Active jobs -->
                <Label Text="Active jobs" FontSize="18" FontAttributes="Bold" Margin="2,8,0,0" />
                <Label x:Name="NoJobsLabel" Text="No active jobs right now."
                       FontSize="14" IsVisible="False" />

                <CollectionView x:Name="JobsList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="14"
                                    Margin="0,0,0,8" StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding VehicleNumber}"
                                               FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding VehicleModel}" FontSize="13" />
                                        <Label Text="{Binding Status}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Total, StringFormat='₹{0:N0}'}"
                                           FontSize="16" FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label x:Name="ErrorLabel" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource Error}}" FontSize="13" IsVisible="False" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
