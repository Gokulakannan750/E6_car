<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E6CarSpa.Mobile.Pages.SettingsPage"
    Title="Settings"
    BackgroundColor="#0F0F0F">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Signed in as" TextColor="#888" FontSize="13" />
                    <Label x:Name="UserLabel" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    <Label x:Name="RoleLabel" TextColor="#B71C1C" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Server address" TextColor="#888" FontSize="12" Margin="2,8,0,0" />
            <Entry x:Name="ServerEntry"
                   Placeholder="https://api.yourshop.com" PlaceholderColor="#888"
                   TextColor="White" BackgroundColor="#262626" Keyboard="Url" />
            <Button x:Name="SaveButton" Text="Save server address"
                    BackgroundColor="#333" TextColor="White" Clicked="OnSaveClicked" />
            <Label x:Name="SavedLabel" Text="Saved." TextColor="#7CC47C" FontSize="13" IsVisible="False" />

            <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,8" />

            <Button x:Name="LogoutButton" Text="Log out"
                    BackgroundColor="#B71C1C" TextColor="White" FontAttributes="Bold"
                    Clicked="OnLogoutClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
