<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E6CarSpa.Mobile.Pages.SettingsPage"
    Title="Settings"
    Shell.PresentationMode="ModalAnimated"
    Shell.NavBarIsVisible="False"
   >

    <!-- Presented as a MODAL over the whole app (not pushed onto a tab's stack), so opening it
         from any tab's gear returns you to that same tab on close — and never leaves Settings
         sitting on a tab. A modal has no automatic back arrow, so the Shell nav bar is hidden
         and replaced by the custom header below with an always-visible Back control (hardware
         and gesture back dismiss it too). -->
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="4,6"
              BackgroundColor="{AppThemeBinding Light={StaticResource NavLight}, Dark={StaticResource NavDark}}">
            <Button Grid.Column="0" Text="← Back" Clicked="OnCloseClicked"
                    BackgroundColor="Transparent" TextColor="White" FontSize="15" Padding="12,6" />
            <Label Grid.Column="1" Text="Settings" TextColor="White" FontSize="18" FontAttributes="Bold"
                   VerticalOptions="Center" Margin="4,0,0,0" />
        </Grid>

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Signed in as" FontSize="13" />
                    <Label x:Name="UserLabel" FontSize="18" FontAttributes="Bold" />
                    <Label x:Name="RoleLabel" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- Theme toggle -->
            <Border Style="{StaticResource CardBorder}" StrokeThickness="0" Padding="16" StrokeShape="RoundRectangle 12">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0" Text="Dark Mode" FontSize="16" FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Switch x:Name="ThemeSwitch" Grid.Row="0" Grid.Column="1"
                            Toggled="OnThemeToggled" />
                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Switch between light and dark colour modes"
                           FontSize="12" Opacity="0.6" />
                </Grid>
            </Border>

            <Label Text="Server address" FontSize="12" Margin="2,8,0,0" />
            <Entry x:Name="ServerEntry"
                   Placeholder="https://api.yourshop.com"
                   Keyboard="Url" />
            <Button x:Name="SaveButton" Text="Save server address"
                    Clicked="OnSaveClicked" />
            <Label x:Name="SavedLabel" Text="Saved." TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource Success}}" FontSize="13" IsVisible="False" />

            <BoxView HeightRequest="1" Margin="0,8" />

            <Button x:Name="LogoutButton" Text="Log out"
                    FontAttributes="Bold"
                    Clicked="OnLogoutClicked" />

            <Label Text="Powered by Trovotech Solutions" FontSize="11" HorizontalTextAlignment="Center"
                   Margin="0,16,0,0"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
