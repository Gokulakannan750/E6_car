<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Semantic Brand Colors -->
    <!-- Crimson accent, legible on BOTH the white cards (light) and charcoal cards (dark), since
         it's referenced the same in both themes by many controls. -->
    <Color x:Key="Primary">#D6303B</Color>
    <Color x:Key="PrimaryDark">#B3121F</Color>
    <Color x:Key="PrimaryText">#FFFFFF</Color>

    <!-- The top/tab bar: deep crimson in light (Refined red), neutral charcoal in dark
         (Clean neutral — no red bar, red is only an accent). -->
    <Color x:Key="NavLight">#B3121F</Color>
    <Color x:Key="NavDark">#171B21</Color>
    <!-- Selected tab accent in dark mode — a brighter red so it reads on the charcoal bar. -->
    <Color x:Key="TabActiveDark">#F0555E</Color>

    <!-- Backgrounds -->
    <Color x:Key="LightBackground">#F5F4F2</Color>
    <Color x:Key="DarkBackground">#0F1216</Color>

    <!-- Surfaces (Cards, Dialogs) -->
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="DarkSurface">#171B21</Color>

    <!-- Text -->
    <Color x:Key="LightText">#171717</Color>
    <Color x:Key="DarkText">#F3F4F6</Color>
    <Color x:Key="LightTextSecondary">#6B7280</Color>
    <Color x:Key="DarkTextSecondary">#9CA3AF</Color>

    <!-- Borders -->
    <Color x:Key="LightBorder">#ECEBE8</Color>
    <Color x:Key="DarkBorder">#262B33</Color>

    <!-- Status Colors -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Error">#EF4444</Color>
    
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">#00000000</Color>

</ResourceDictionary>