<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Semantic Brand Colors -->
    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1D4ED8</Color>
    <Color x:Key="PrimaryText">#FFFFFF</Color>

    <!-- Backgrounds -->
    <Color x:Key="LightBackground">#F9FAFB</Color>
    <!-- Softer black for dark mode -->
    <Color x:Key="DarkBackground">#121212</Color>
    
    <!-- Surfaces (Cards, Dialogs) -->
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="DarkSurface">#1E1E1E</Color>

    <!-- Text -->
    <Color x:Key="LightText">#111827</Color>
    <Color x:Key="DarkText">#F9FAFB</Color>
    <Color x:Key="LightTextSecondary">#6B7280</Color>
    <Color x:Key="DarkTextSecondary">#9CA3AF</Color>

    <!-- Borders -->
    <Color x:Key="LightBorder">#E5E7EB</Color>
    <Color x:Key="DarkBorder">#374151</Color>

    <!-- Status Colors -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Error">#EF4444</Color>
    
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">#00000000</Color>

</ResourceDictionary>